---
import BaseLayout from './BaseLayout.astro';
import { SITE, TOOLS } from '../consts';

interface Props {
  title: string;
  /** 給搜尋引擎看的標題；沒給就用 title */
  seoTitle?: string;
  emoji: string;
  summary: string;
  time: string;
  description?: string;
}
const { title, seoTitle, emoji, summary, time, description } = Astro.props;

// 從網址對回 consts.ts 裡的工具設定，拿到永久編號、版本與更新日期
const path = Astro.url.pathname.replace(/\/$/, '');
const tool = TOOLS.find((t) => t.href === path);
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString() ?? 'https://snowmed-taiwan.com/';

// 引用格式：仿學術引用，讓「標明出處」有一個現成的、可以直接貼的樣子
const citation = tool
  ? `${SITE.doctor.replace(/\s/g, '')}. ${title}（${tool.id}，${tool.version}，${tool.updated} 更新）. ${SITE.name}. ${canonical}`
  : null;

// 工具頁的結構化資料：這是一個醫療衛教網頁，誰審的、什麼時候更新、編號版本
const toolLd = tool
  ? {
      '@context': 'https://schema.org',
      '@type': 'MedicalWebPage',
      '@id': `${canonical}#tool`,
      url: canonical,
      name: seoTitle ?? title,
      headline: title,
      description: description ?? summary,
      inLanguage: 'zh-Hant-TW',
      identifier: tool.id,
      version: tool.version,
      dateModified: tool.updated,
      lastReviewed: tool.updated,
      audience: { '@type': 'Audience', audienceType: '滑雪與單板滑雪愛好者' },
      reviewedBy: { '@id': `${siteUrl}#doctor` },
      author: { '@id': `${siteUrl}#doctor` },
      publisher: { '@id': `${siteUrl}#organization` },
      isPartOf: { '@id': `${siteUrl}#website` },
      license: 'https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hant',
    }
  : null;
---

<BaseLayout title={title} seoTitle={seoTitle} banner={false} description={description ?? summary}>
  <Fragment slot="head">
    {toolLd && <script type="application/ld+json" set:html={JSON.stringify(toolLd)} />}
  </Fragment>

  <!-- 工具標頭 -->
  <section class="border-b border-line bg-band text-white on-dark">
    <div class="mx-auto max-w-3xl px-5 py-10 sm:py-14">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <a href="/tools" class="text-sm font-bold text-accent hover:underline">← 所有工具</a>
        {
          tool && (
            <a
              href="#cite"
              class="rounded-full border border-line px-3 py-1 font-mono text-[11px] tracking-wide text-body hover:bg-tint1"
              title="工具編號與版本，點一下看引用方式"
            >
              {tool.id} · {tool.version}
            </a>
          )
        }
      </div>

      <div class="mt-6 flex items-start gap-4">
        <span class="text-4xl leading-none sm:text-5xl" aria-hidden="true">{emoji}</span>
        <div class="min-w-0">
          <h1 class="text-2xl leading-snug font-black break-words sm:text-3xl">{title}</h1>
          <p class="mt-1 text-xs text-muted">{time}</p>
        </div>
      </div>

      <p class="mt-5 text-base leading-relaxed break-words text-body">{summary}</p>
    </div>
  </section>

  <!-- 工具本體 -->
  <section class="bg-panel">
    <div class="mx-auto max-w-3xl px-5 py-10 sm:py-14">
      <slot />
    </div>
  </section>

  <!-- 依據與限制 -->
  <section class="bg-surface">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
      <h2 class="text-xl font-black text-head">這個工具是根據什麼做的？</h2>
      <div class="prose-tc mt-4 text-[15px] break-words text-muted">
        <slot name="basis" />
      </div>

      <h2 class="mt-10 text-xl font-black text-head">什麼情況下不適用？</h2>
      <div class="prose-tc mt-4 text-[15px] break-words text-muted">
        <slot name="limits" />
      </div>

      <div class="mt-10">
        <slot name="faq" />
      </div>

      {
        tool && citation && (
          <div id="cite" class="mt-10 scroll-mt-20 rounded-2xl border border-line bg-panel p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="text-base font-black text-head">引用或轉載這個工具</h2>
              <p class="font-mono text-xs text-muted">
                {tool.id} · {tool.version} · {tool.updated} 更新
              </p>
            </div>
            <p class="mt-2 text-sm leading-relaxed break-words text-muted">
              歡迎引用、教學、轉載。條件是<strong class="text-head">標明出處、非商業使用、改作後以相同方式分享</strong>（CC
              BY-NC-SA 4.0）。請把編號與版本一起帶上，這樣讀者才知道看到的是不是最新版。
            </p>
            <div class="mt-3 flex min-w-0 flex-col gap-2 sm:flex-row sm:items-start">
              <code
                id="cite-text"
                class="min-w-0 flex-1 rounded-xl border border-line bg-surface px-4 py-3 text-xs leading-relaxed break-all text-body select-all"
              >
                {citation}
              </code>
              <button
                type="button"
                id="cite-copy"
                class="shrink-0 rounded-xl border border-line bg-surface px-4 py-3 text-xs font-bold text-head hover:bg-tint1"
              >
                複製
              </button>
            </div>
            <p class="mt-3 text-xs leading-relaxed break-words text-muted">
              授權條款：
              <a
                href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hant"
                target="_blank"
                rel="noopener noreferrer license"
                class="underline underline-offset-2 hover:text-head"
              >
                創用 CC 姓名標示－非商業性－相同方式分享 4.0
              </a>
            </p>
          </div>
        )
      }

      <div class="mt-10 rounded-2xl border-l-4 border-accent bg-panel p-6">
        <p class="text-sm leading-relaxed break-words text-muted">
          <strong class="text-head">重要提醒：</strong
          >這個工具提供的是一般性的健康資訊，不是醫療診斷，也不能取代醫師面對面的診察。它的設計原則是「有疑慮就建議你去看醫師」——
          如果結果和你的實際感受不一致，請以你的身體感受和專業醫療意見為準。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const btn = document.getElementById('cite-copy');
  const text = document.getElementById('cite-text')?.textContent?.trim();
  if (btn && text) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '已複製';
      } catch {
        btn.textContent = '請手動選取複製';
      }
      setTimeout(() => (btn.textContent = '複製'), 2000);
    });
  }
</script>
