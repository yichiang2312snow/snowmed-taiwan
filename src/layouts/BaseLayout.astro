---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { SITE, SITE_A } from '../consts';

interface Props {
  title?: string;
  /**
   * 給搜尋引擎看的標題（瀏覽器分頁與搜尋結果用）。
   * 頁面上的 H1 可以短而有個性，這裡則放大家實際會搜的字；沒給就用 title。
   */
  seoTitle?: string;
  description?: string;
  /** 頁面主標題下的小字說明，會顯示在頁首橫幅 */
  eyebrow?: string;
  /** 是否顯示頁首藍色橫幅（文章頁自己有 HERO，所以關掉） */
  banner?: boolean;
  /** 社群分享預覽圖（絕對網址或站內路徑），沒給就用預設圖 */
  ogImage?: string;
  /** 不要被搜尋引擎收錄（後台那種頁面用） */
  noindex?: boolean;
}

const {
  title,
  seoTitle,
  description = SITE.description,
  eyebrow,
  banner = true,
  ogImage = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const headTitle = seoTitle ?? title;
const pageTitle = headTitle ? `${headTitle}｜${SITE.name}` : `${SITE.name}｜${SITE.poweredByShort}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const siteUrl = Astro.site?.toString() ?? 'https://snowmed-taiwan.com/';

// 讓搜尋引擎知道：這是一個網站、由誰發布、發布者是誰、他在哪些平台
// 用 @id 互相指涉，同一個人／組織在各頁只會被認成一個實體
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: SITE.name,
      alternateName: SITE.nameEn,
      description: SITE.description,
      inLanguage: 'zh-Hant-TW',
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: SITE.name,
      alternateName: SITE.nameEn,
      url: siteUrl,
      logo: { '@type': 'ImageObject', url: ogImageUrl },
      founder: { '@id': `${siteUrl}#doctor` },
      sameAs: [SITE_A.url, SITE.threads],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#doctor`,
      name: SITE.doctor.replace(/\s/g, ''),
      alternateName: SITE.doctorEn,
      jobTitle: '復健科專科醫師',
      knowsAbout: ['滑雪運動傷害', '滑雪運動醫學', '運動傷害復健', 'Ski injury', 'Snowboard injury'],
      url: SITE_A.url,
      sameAs: [SITE_A.url, SITE.threads],
      worksFor: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@id': `${siteUrl}#website` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
    },
  ],
};
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* 在畫面繪製前就套用使用者選過的主題，避免深淺色閃一下 */}
    <script is:inline>
      try {
        if (localStorage.getItem('snowmed:theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch (e) {
        /* 讀不到就用預設的深色 */
      }
    </script>

    <meta name="google-site-verification" content="V-uVFPiV6kkXil1WbZ_AN-dLmdfMrIJJw8wJnHYYFIg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap"
    />

    {/*
      圖示放實體檔案而不是 data URI —— Google 搜尋結果只抓得到真的網址，
      iOS 加到主畫面也需要 apple-touch-icon，不然會是一片空白。
      原始圖形在 public/icon.svg，其他尺寸都是從它輸出的。
    */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#08243c" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-band focus:px-4 focus:py-2 focus:text-white"
      >跳至主要內容</a
    >
    <Header />
    <main id="main" class="flex-1">
      {
        title && banner && (
          <section class="border-b border-line bg-band text-white on-dark">
            <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
              {eyebrow && (
                <p class="mb-3 text-sm font-medium tracking-widest text-accent uppercase">
                  {eyebrow}
                </p>
              )}
              <h1 class="text-3xl font-black sm:text-4xl">{title}</h1>
            </div>
          </section>
        )
      }
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
