---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ViewCountScript from '../components/ViewCountScript.astro';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** 頁面主標題下的小字說明，會顯示在頁首橫幅 */
  eyebrow?: string;
  /** 是否顯示頁首藍色橫幅（文章頁自己有 HERO，所以關掉） */
  banner?: boolean;
}

const { title, description = SITE.description, eyebrow, banner = true } = Astro.props;

const pageTitle = title ? `${title}｜${SITE.doctor} · ${SITE.name}` : `${SITE.doctor}｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={`${SITE.doctor}｜${SITE.name}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap"
    />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230e3450'/%3E%3Cpath d='M50 18v64M22 34l56 32M78 34L22 66' stroke='%237dd3fc' stroke-width='9' stroke-linecap='round'/%3E%3C/svg%3E"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Physician',
        name: SITE.doctor,
        alternateName: SITE.doctorEn,
        medicalSpecialty: 'SportsMedicine',
        description: SITE.description,
        url: Astro.site?.toString(),
        areaServed: 'TW',
      })}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-deep focus:px-4 focus:py-2 focus:text-white"
      >跳至主要內容</a
    >
    <Header />
    <main id="main" class="flex-1">
      {
        title && banner && (
          <section class="border-b border-ice bg-deep text-white">
            <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
              {eyebrow && (
                <p class="mb-3 text-sm font-medium tracking-widest text-brandlight uppercase">
                  {eyebrow}
                </p>
              )}
              <h1 class="text-3xl font-black sm:text-4xl">{title}</h1>
            </div>
          </section>
        )
      }
      <slot />
    </main>
    <Footer />
    <ViewCountScript />
  </body>
</html>
