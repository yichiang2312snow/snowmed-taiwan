---
/**
 * 滑雪安全複習測驗
 *
 * 從題庫隨機抽 10 題，每答完一題立刻給詳解與「回去看這一段」的連結。
 * 目的不是考倒人，是讓看過站上內容的人知道自己哪裡沒吸收到，然後直接回去補。
 *
 * 抽題刻意不是純隨機：先打散分類再輪流取，十題才不會全部集中在同一個主題。
 * 題庫與正確答案都在前端（這是複習工具不是考試，沒有防作弊的需求），
 * 但一次只把抽中的十題丟進畫面，不會把整份題庫攤在 DOM 上。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { QUIZ_QUESTIONS, CATEGORY_LABELS } from '../data/quizQuestions';

const DRAW = 10;
const title = '滑雪安全複習測驗';
const seoTitle = '滑雪安全複習測驗｜10 題隨機抽考，附詳解與出處';
const description = `從 ${QUIZ_QUESTIONS.length} 題題庫隨機抽 10 題，涵蓋行前準備、裝備護具、雪場選擇與各部位運動傷害。每題答完立刻給詳解，並附上該觀念出自哪一頁，可以直接回去複習。免費、免註冊。`;

const total = QUIZ_QUESTIONS.length;
const categories = Object.values(CATEGORY_LABELS);
---

<BaseLayout title={title} seoTitle={seoTitle} description={description} eyebrow="Quiz">
  <section class="bg-band text-white on-dark">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
      <p class="text-xs font-black tracking-widest text-accent uppercase">複習測驗</p>
      <h1 class="mt-3 text-2xl leading-tight font-black break-words sm:text-4xl">
        你真的學會了嗎？{DRAW} 題隨機抽考
      </h1>
      <p class="mt-4 text-sm leading-relaxed break-words text-body sm:text-base">
        題庫共 <strong class="text-head">{total} 題</strong>，每次隨機抽 {DRAW} 題。
        答完一題立刻給詳解，並告訴你這個觀念出自哪一頁 —— 答錯的地方可以直接點回去再看一次。
      </p>
      <p class="mt-3 text-xs leading-relaxed break-words text-muted">
        涵蓋範圍：{categories.join('、')}
      </p>
    </div>
  </section>

  <section class="bg-surface">
    <div class="mx-auto max-w-3xl px-5 py-10 sm:py-14">
      <!-- 開始畫面 -->
      <div id="quiz-intro">
        <div class="rounded-2xl border-l-4 border-accent bg-tint1 p-6">
          <p class="text-sm leading-relaxed break-words text-head">
            這不是考試，是<strong>複習</strong>。答錯沒有關係 —— 重點是知道自己哪一塊還沒吸收到，
            然後用詳解下面的連結回去把那一段看完。
          </p>
        </div>
        <button
          type="button"
          id="quiz-start"
          class="mt-6 w-full cursor-pointer rounded-xl bg-cta px-6 py-4 text-base font-bold text-ctatext transition-colors hover:bg-accent"
        >
          開始測驗 →
        </button>
      </div>

      <!-- 作答畫面 -->
      <div id="quiz-play" hidden>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="text-sm font-bold text-head">
            第 <span id="quiz-idx" class="tabular-nums">1</span> / {DRAW} 題
          </p>
          <p class="text-xs text-muted">
            目前答對 <span id="quiz-correct" class="tabular-nums font-bold text-accent">0</span> 題
          </p>
        </div>
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-tint2">
          <div id="quiz-bar" class="h-full rounded-full bg-accent transition-all duration-300" style="width:0%"></div>
        </div>

        <div class="mt-6 rounded-2xl border border-line bg-panel p-6">
          <p id="quiz-cat" class="text-xs font-black tracking-widest text-accent uppercase"></p>
          <p id="quiz-q" class="mt-3 text-base leading-relaxed font-bold break-words text-head sm:text-lg"></p>
          <div id="quiz-options" class="mt-5 space-y-3"></div>
        </div>

        <!-- 詳解 -->
        <div id="quiz-explain" hidden class="mt-5 rounded-2xl border-l-4 p-6">
          <p id="quiz-verdict" class="text-base font-black"></p>
          <p id="quiz-explain-text" class="mt-3 text-sm leading-relaxed break-words text-body"></p>
          <a
            id="quiz-source"
            href="#"
            target="_blank"
            rel="noopener"
            class="mt-4 inline-block rounded-xl border border-line bg-surface px-4 py-2.5 text-sm font-bold text-head transition-colors hover:border-accent hover:bg-tint1"
          ></a>
          <button
            type="button"
            id="quiz-next"
            class="mt-5 w-full cursor-pointer rounded-xl bg-cta px-6 py-3.5 text-sm font-bold text-ctatext transition-colors hover:bg-accent"
          >
            下一題 →
          </button>
        </div>
      </div>

      <!-- 結果畫面 -->
      <div id="quiz-result" hidden>
        <div class="rounded-2xl border-l-4 border-accent bg-tint1 p-6 sm:p-8">
          <p class="text-xs font-black tracking-widest text-muted uppercase">你的成績</p>
          <p class="mt-3 flex flex-wrap items-baseline gap-2">
            <span id="quiz-score" class="text-5xl leading-none font-black text-head tabular-nums">0</span>
            <span class="text-lg font-black text-muted">/ {DRAW} 題</span>
          </p>
          <p id="quiz-comment" class="mt-4 text-sm leading-relaxed break-words text-body"></p>
        </div>

        <h2 class="mt-8 text-lg font-black text-head">逐題檢討</h2>
        <p class="mt-1.5 text-sm text-muted">答錯的題目排在前面。點連結回去把那一段看完。</p>
        <ul id="quiz-review" class="mt-4 space-y-3"></ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <button
            type="button"
            id="quiz-again"
            class="cursor-pointer rounded-xl bg-cta px-6 py-3.5 text-sm font-bold text-ctatext transition-colors hover:bg-accent"
          >
            再抽 10 題
          </button>
          <a
            href="/tools"
            class="rounded-xl border border-line bg-panel px-6 py-3.5 text-sm font-bold text-head transition-colors hover:bg-tint1"
          >
            回去用工具
          </a>
        </div>
      </div>
    </div>
  </section>

  <script
    type="application/json"
    id="quiz-data"
    set:html={JSON.stringify(
      QUIZ_QUESTIONS.map((q) => ({
        i: q.id,
        c: CATEGORY_LABELS[q.category],
        k: q.category,
        q: q.q,
        o: q.options,
        a: q.answer,
        e: q.explain,
        s: q.source,
      }))
    )}
  />

  <script define:vars={{ DRAW }}>
    const bank = JSON.parse(document.getElementById('quiz-data').textContent);

    const el = (id) => document.getElementById(id);
    const shuffle = (arr) => {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };

    /**
     * 抽題：先依分類分組並各自打散，再輪流從每一組拿一題。
     * 純隨機有機會十題全是同一個主題，複習的效果就差很多。
     */
    const draw = () => {
      const groups = {};
      for (const q of bank) (groups[q.k] ??= []).push(q);
      const buckets = shuffle(Object.values(groups).map(shuffle));
      const picked = [];
      let round = 0;
      while (picked.length < DRAW) {
        let added = false;
        for (const b of buckets) {
          if (b.length > round) {
            picked.push(b[round]);
            added = true;
            if (picked.length === DRAW) break;
          }
        }
        if (!added) break; // 題庫不夠（理論上不會發生）
        round++;
      }
      return shuffle(picked);
    };

    let quiz = [];
    let at = 0;
    let correct = 0;
    let answered = [];

    const showQuestion = () => {
      const q = quiz[at];
      el('quiz-idx').textContent = String(at + 1);
      el('quiz-correct').textContent = String(correct);
      el('quiz-bar').style.width = (at / DRAW) * 100 + '%';
      el('quiz-cat').textContent = q.c;
      el('quiz-q').textContent = q.q;

      const box = el('quiz-options');
      box.innerHTML = '';
      q.o.forEach((text, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className =
          'quiz-opt block w-full cursor-pointer rounded-xl border border-line bg-surface px-4 py-3.5 text-left text-sm leading-relaxed break-words text-head transition-colors hover:border-accent hover:bg-tint1';
        btn.innerHTML =
          '<span class="mr-2 font-black text-accent">' + 'ABCD'[i] + '</span>' + text;
        btn.addEventListener('click', () => answer(i));
        box.appendChild(btn);
      });

      el('quiz-explain').hidden = true;
    };

    const answer = (chosen) => {
      const q = quiz[at];
      const ok = chosen === q.a;
      if (ok) correct++;
      answered.push({ q, chosen, ok });

      // 鎖住選項，並標出正確與（答錯時）你選的那一個
      [...document.querySelectorAll('.quiz-opt')].forEach((b, i) => {
        b.disabled = true;
        b.classList.remove('hover:border-accent', 'hover:bg-tint1', 'cursor-pointer');
        if (i === q.a) b.classList.add('border-emerald-400', 'bg-emerald-500/15');
        else if (i === chosen) b.classList.add('border-red-400', 'bg-red-500/15');
        else b.classList.add('opacity-60');
      });

      const box = el('quiz-explain');
      box.hidden = false;
      box.className =
        'mt-5 rounded-2xl border-l-4 p-6 ' +
        (ok ? 'border-emerald-400 bg-emerald-500/10' : 'border-red-400 bg-red-500/10');
      el('quiz-verdict').textContent = ok ? '✅ 答對了' : '❌ 答錯了';
      el('quiz-verdict').className =
        'text-base font-black ' + (ok ? 'text-emerald-300 light:text-emerald-800' : 'text-red-300 light:text-red-800');
      el('quiz-explain-text').textContent = q.e;
      const src = el('quiz-source');
      src.href = q.s.href;
      src.textContent = '📄 回去看：' + q.s.label + ' ↗';

      el('quiz-correct').textContent = String(correct);
      el('quiz-next').textContent = at === DRAW - 1 ? '看成績 →' : '下一題 →';
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };

    const finish = () => {
      el('quiz-play').hidden = true;
      el('quiz-result').hidden = false;
      el('quiz-score').textContent = String(correct);

      const pct = (correct / DRAW) * 100;
      el('quiz-comment').textContent =
        pct >= 90
          ? '非常好，這些觀念你都掌握住了。出發前再把檢核表跑一次就可以了。'
          : pct >= 70
            ? '底子不錯，少數幾個觀念再補一下。下面答錯的那幾題值得點進去看完。'
            : pct >= 40
              ? '有一些重要的觀念還沒吸收到。建議先把答錯那幾題的連結看完，再測一次。'
              : '這些都是會影響安全的觀念，值得花點時間補起來。從下面的連結開始看，看完再抽一次。';

      const list = el('quiz-review');
      list.innerHTML = '';
      // 答錯的排前面，才不用自己找
      [...answered].sort((a, b) => Number(a.ok) - Number(b.ok)).forEach((r) => {
        const li = document.createElement('li');
        li.className =
          'min-w-0 rounded-xl border bg-panel p-4 ' + (r.ok ? 'border-line' : 'border-red-400/60');
        li.innerHTML =
          '<p class="text-sm font-bold break-words text-head">' +
          (r.ok ? '✅ ' : '❌ ') +
          r.q.q +
          '</p>' +
          '<p class="mt-2 text-sm leading-relaxed break-words text-muted"><strong class="text-head">正解：</strong>' +
          r.q.o[r.q.a] +
          '</p>' +
          '<p class="mt-1.5 text-xs leading-relaxed break-words text-muted">' +
          r.q.e +
          '</p>' +
          '<a href="' +
          r.q.s.href +
          '" target="_blank" rel="noopener" class="mt-3 inline-block text-sm font-bold text-accent hover:underline">📄 ' +
          r.q.s.label +
          ' ↗</a>';
        list.appendChild(li);
      });

      el('quiz-result').scrollIntoView({ behavior: 'smooth', block: 'start' });

      // 統計：完成一次測驗。
      // 整份作答結果收成一個請求送出，不是每題送一次 ——
      // 每題一個事件的話一次測驗要寫 11 次 KV，免費方案一天只有 1,000 次。
      try {
        navigator.sendBeacon?.(
          '/api/stats',
          new Blob([JSON.stringify({ e: 'done', l: 'quiz' })], { type: 'application/json' })
        );
        navigator.sendBeacon?.(
          '/api/quiz',
          new Blob(
            [JSON.stringify({ score: correct, answers: answered.map((r) => ({ id: r.q.i, ok: r.ok })) })],
            { type: 'application/json' }
          )
        );
      } catch {
        /* 統計失敗不影響使用者 */
      }
    };

    const start = () => {
      quiz = draw();
      at = 0;
      correct = 0;
      answered = [];
      el('quiz-intro').hidden = true;
      el('quiz-result').hidden = true;
      el('quiz-play').hidden = false;
      showQuestion();
      try {
        navigator.sendBeacon?.(
          '/api/stats',
          new Blob([JSON.stringify({ e: 'tool', l: 'quiz' })], { type: 'application/json' })
        );
      } catch {
        /* 忽略 */
      }
    };

    el('quiz-start').addEventListener('click', start);
    el('quiz-again').addEventListener('click', () => {
      start();
      el('quiz-play').scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    el('quiz-next').addEventListener('click', () => {
      if (at === DRAW - 1) {
        el('quiz-bar').style.width = '100%';
        finish();
        return;
      }
      at++;
      showQuestion();
    });
  </script>
</BaseLayout>
