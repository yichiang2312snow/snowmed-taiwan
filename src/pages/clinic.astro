---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

const services = [
  {
    id: 'pre-season',
    label: '行前評估',
    title: '滑雪行前體能評估與訓練處方',
    who: '適合：第一次要上雪、有舊傷想確認能不能滑、想提升滑行續航力的人',
    body: [
      '過去傷病史與現有症狀的完整詢問',
      '下肢肌力、單腳穩定度、平衡與活動度的客觀測量',
      '找出你個人的弱連結（常見是臀肌無力或踝關節活動度不足）',
      '給一份可以帶回家執行的分期訓練計畫，並安排追蹤',
    ],
  },
  {
    id: 'injury',
    label: '傷害診治',
    title: '雪地運動傷害的診斷與治療',
    who: '適合：在雪場受傷、回國後仍持續疼痛或不穩定的人',
    body: [
      '針對雪地受傷機轉的詳細問診（怎麼摔的，往往比影像更重要）',
      '理學檢查與必要的影像安排、國外影像與診斷書的判讀',
      '擬定治療策略：保守治療或轉介手術，以及各自的時間成本',
      '與復健治療端銜接，確保復健方向對準「回到雪上」而不只是「不痛」',
    ],
  },
  {
    id: 'return-to-snow',
    label: '回歸雪場',
    title: 'Return to Snow 回歸評估',
    who: '適合：手術後或受傷後，想知道「什麼時候能再滑」的人',
    body: [
      '用客觀指標取代單純的時間表（例如患側／健側肌力對稱性）',
      '跳躍與落地控制的功能性測試',
      '心理準備度評估 —— 怕再受傷，本身就是再受傷的風險因子',
      '第一趟回雪場的具體規劃：雪場選擇、難度、每日時數、休息安排',
    ],
  },
];
---

<BaseLayout
  title="門診與諮詢"
  eyebrow="Clinic"
  description="滑雪行前體能評估、雪地運動傷害診治、回歸雪場評估 —— 楊怡強醫師提供的滑雪運動醫學服務內容說明。"
>
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-5 py-14 sm:py-16">
      <p class="text-lg leading-relaxed font-medium text-deep">
        三種最常見的需求，對應三種不同的看診方式。不確定自己屬於哪一種，直接聯絡我也可以。
      </p>
      <div class="mt-8 flex flex-wrap gap-2">
        {
          services.map((s) => (
            <a
              href={`#${s.id}`}
              class="rounded-full border border-ice bg-snow px-4 py-2 text-sm font-bold text-deep hover:border-brandlight hover:bg-ice/50"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    services.map((s, i) => (
      <section id={s.id} class={i % 2 === 0 ? 'bg-snow' : 'bg-white'}>
        <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
          <div class="grid gap-8 lg:grid-cols-[1fr_1.3fr]">
            <div>
              <p class="text-xs font-black tracking-[0.2em] text-brand uppercase">
                0{i + 1} · {s.label}
              </p>
              <h2 class="mt-3 text-2xl font-black text-deep">{s.title}</h2>
              <p class="mt-4 rounded-xl bg-ice/60 px-4 py-3 text-sm leading-relaxed text-deep">
                {s.who}
              </p>
            </div>
            <ul class="space-y-3.5">
              {s.body.map((b) => (
                <li class="flex gap-3 rounded-xl border border-ice bg-white p-4 text-sm leading-relaxed text-slate-soft">
                  <svg
                    viewBox="0 0 20 20"
                    class="mt-0.5 h-5 w-5 shrink-0 text-brandlight"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M8.2 14.3 4 10.1l1.4-1.4 2.8 2.8 6.4-6.4L16 6.5z" />
                  </svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))
  }

  <section class="bg-ice/50">
    <div class="mx-auto max-w-3xl px-5 py-14">
      <div class="rounded-2xl border border-ice bg-white p-7">
        <h2 class="text-lg font-black text-deep">看診地點與時段</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-soft">
          {
            SITE.clinicName
              ? `${SITE.clinicName}${SITE.clinicAddress ? ` · ${SITE.clinicAddress}` : ''}`
              : '【待補】看診院所、地址與門診時段。'
          }
        </p>
        <a
          href="/contact"
          class="mt-6 inline-block rounded-xl bg-brand px-6 py-3 text-sm font-bold text-white hover:bg-deep"
          >聯絡與預約</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
