---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE } from '../consts';
import { lastUpdated } from '../lib/lastUpdated';
import { formatDate } from '../lib/format';
import heroImage from '../assets/hero-ski-slope.jpg';

// 文章列表在建置時就直接寫進 HTML（不是用 JavaScript 讀 JSON 生出來），
// 這樣 Google 爬蟲一抓就看得到全部內容。
const entries = await getCollection('articles', ({ data }) => !data.draft);

const posts = entries
  .map((entry) => {
    const updated = lastUpdated(entry.filePath);
    return {
      entry,
      updated,
      // 排序基準：發佈日期和最後更新時間取較晚者 —— 新文章和剛改過的文章都會排到前面
      sortKey: Math.max(entry.data.date.valueOf(), updated?.valueOf() ?? 0),
    };
  })
  .sort((a, b) => b.sortKey - a.sortKey);

const siteUpdated = posts.length > 0 ? new Date(posts[0].sortKey) : null;

const categories = [...new Set(posts.map((p) => p.entry.data.category))];
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-deep text-white">
    <Image
      src={heroImage}
      alt="高山雪場的滑雪道與纜車，遠方是連綿的雪山稜線"
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-deep/95 via-deep/88 to-deep/70"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-5xl px-5 py-20 sm:py-28 lg:py-32">
      <p
        class="mb-5 inline-block rounded-full border border-brandlight/60 bg-deep/40 px-4 py-1.5 text-[11px] font-bold tracking-[0.15em] text-brandlight sm:text-xs"
      >
        SKI &amp; SNOWSPORTS MEDICINE · TAIWAN
      </p>
      <h1 class="max-w-3xl text-[1.75rem] leading-tight font-black sm:text-5xl lg:text-6xl">
        <span class="block">台灣第一位</span>
        <span class="block">專攻滑雪運動醫學的醫師</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed break-words text-ice/90 sm:text-lg">
        台灣沒有雪季，卻有幾十萬名滑雪愛好者。出發前該怎麼練、在雪場受傷了怎麼辦、傷後多久能再上山
        —— 這些問題不該只能靠雪友之間口耳相傳。
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#articles"
          class="rounded-xl bg-white px-6 py-3.5 text-sm font-bold text-deep transition-colors hover:bg-ice"
          >閱讀衛教文章</a
        >
        <a
          href="/contact"
          class="rounded-xl border border-white/40 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white/10"
          >預約門診與諮詢</a
        >
      </div>

      <p class="mt-10 text-sm text-ice/70">{SITE.doctor} · {SITE.doctorEn}</p>
    </div>
  </section>

  <!-- 文章索引 -->
  <section id="articles" class="scroll-mt-20 bg-snow">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="min-w-0">
          <p class="mb-2 text-xs font-bold tracking-[0.2em] text-brand uppercase">Articles</p>
          <h2 class="text-2xl font-black text-deep sm:text-3xl">衛教文章</h2>
        </div>
        {
          siteUpdated && (
            <p class="text-xs text-slate-soft">
              共 {posts.length} 篇 · 最後更新 {formatDate(siteUpdated)}
            </p>
          )
        }
      </div>

      {
        categories.length > 1 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {categories.map((c) => (
              <span class="rounded-full border border-ice bg-white px-3 py-1.5 text-xs font-bold text-deep">
                {c}
              </span>
            ))}
          </div>
        )
      }

      {
        posts.length > 0 ? (
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map(({ entry, updated }) => (
              <ArticleCard
                slug={entry.id}
                title={entry.data.title}
                description={entry.data.description}
                date={entry.data.date}
                updated={updated}
                author={entry.data.author}
                category={entry.data.category}
                image={entry.data.heroImage}
                imageAlt={entry.data.heroAlt}
              />
            ))}
          </div>
        ) : (
          <p class="mt-10 rounded-2xl border-2 border-dashed border-ice bg-white p-10 text-center text-sm text-slate-soft">
            還沒有文章。在 <code>src/content/articles/</code> 放一個 .md 檔就會出現在這裡。
          </p>
        )
      }
    </div>
  </section>

  <!-- 簡介 -->
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
        <div class="min-w-0">
          <p class="mb-2 text-xs font-bold tracking-[0.2em] text-brand uppercase">About</p>
          <h2 class="text-2xl font-black text-deep sm:text-3xl">
            <span class="block">為什麼需要</span>
            <span class="block">滑雪運動醫學？</span>
          </h2>
        </div>
        <div class="min-w-0 space-y-5 text-base leading-relaxed break-words text-slate-soft">
          <p>
            滑雪的受傷機轉非常特殊：腳被固定器綁在一塊長板上、以高速移動、在低溫與高海拔的環境、而且往往連續好幾天不休息。這些條件加起來，造成的傷害型態和籃球、跑步、健身房完全不同。
          </p>
          <p>
            更麻煩的是，大多數台灣雪友是在<strong class="text-deep">國外受傷</strong>的。語言不通、當地醫療流程陌生、回國後接手的醫師又不熟悉雪場的受傷情境，中間的資訊落差常常讓復原走了冤枉路。
          </p>
          <p>
            這個部落格要做的，就是把這一段補起來 ——
            <strong class="text-deep">從出發前的準備、雪場上的判斷，到回國後的治療與回歸雪場</strong>。
          </p>
          <a href="/about" class="inline-block text-sm font-bold text-brand hover:underline"
            >更多關於我 →</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand text-white">
    <div class="mx-auto max-w-5xl px-5 py-14 text-center sm:py-20">
      <h2 class="text-2xl font-black break-words sm:text-3xl">準備好下一趟雪季了嗎？</h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed break-words text-white/85">
        不管你是第一次上雪、想突破技術瓶頸，還是正在為了受傷苦惱 —— 歡迎跟我聊聊。
      </p>
      <a
        href="/contact"
        class="mt-8 inline-block rounded-xl bg-white px-7 py-3.5 text-sm font-bold text-brand transition-colors hover:bg-ice"
        >聯絡與預約</a
      >
    </div>
  </section>
</BaseLayout>
