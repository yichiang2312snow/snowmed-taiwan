---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { SITE, SITE_A, TOOLS } from '../consts';
import heroImage from '../assets/hero-ski-slope.jpg';

---

<BaseLayout>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-bg text-white">
    <Image
      src={heroImage}
      alt="高山雪場的滑雪道與纜車，遠方是連綿的雪山稜線"
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-bg/96 via-bg/90 to-bg/70"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-24 lg:py-28">
      <p
        class="mb-5 inline-block rounded-full border border-accent/60 bg-bg/50 px-3.5 py-1.5 text-[11px] font-bold tracking-[0.12em] text-accent sm:px-4 sm:text-xs"
      >
        免費 · 免註冊 · 不收集個資
      </p>

      <h1 class="text-[1.75rem] leading-tight font-black sm:text-5xl lg:text-[3.4rem]">
        <span class="block">台灣滑雪運動醫學</span>
        <span class="block">科學平台</span>
      </h1>
      <p class="mt-3 text-xs font-medium text-accent sm:text-sm">
        {SITE.poweredBy}
      </p>

      <p class="mt-7 max-w-2xl text-lg leading-relaxed font-bold break-words text-white sm:text-xl">
        你可能還不認識我，但這裡有你出發滑雪前最需要的小工具。
      </p>

      <p class="mt-4 max-w-2xl text-base leading-relaxed break-words text-body sm:text-lg">
        第一次準備出國滑雪，是否覺得裝備、體能、海外保險排山倒海而來？這個網站專門為滑雪初心者與雪友打造——沒有複雜的理論，只有即點即用的互動小工具與防護清單，幫你省下摸索的力氣，安心享受雪地裡的每一步。
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#tools"
          class="rounded-xl bg-white px-6 py-3.5 text-sm font-bold text-bg transition-colors hover:bg-accent"
          >直接開始用工具</a
        >
        <a
          href="/emergency"
          class="rounded-xl border border-white/40 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-white/10"
          >人在國外受傷了？</a
        >
      </div>
    </div>
  </section>

  <!-- 工具 -->
  <section id="tools" class="scroll-mt-20 bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div class="max-w-2xl">
        <p class="mb-2 text-xs font-bold tracking-[0.2em] text-accent uppercase">Tools</p>
        <h2 class="text-2xl font-black text-head sm:text-3xl">{TOOLS.length} 個滑雪醫學小工具</h2>
        <p class="mt-3 text-base leading-relaxed break-words text-muted">
          不用註冊、不用留 email、不用等回覆。點進去就能用，結果只有你自己看得到。
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {TOOLS.map((t) => <ToolCard {...t} />)}
      </div>
    </div>
  </section>

  <!-- 海外受傷緊急入口 -->
  <section class="bg-red-500/15">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:py-12">
      <div class="flex flex-wrap items-center justify-between gap-5 rounded-2xl border-2 border-red-500 bg-panel p-6 sm:p-8">
        <div class="min-w-0">
          <p class="text-xs font-black tracking-widest text-red-200 uppercase">Emergency</p>
          <h2 class="mt-2 text-xl font-black break-words text-head sm:text-2xl">
            人在國外雪場，受傷了？
          </h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed break-words text-muted">
            急救電話、PEACE &amp; LOVE 急性處置原則、日本主要雪場附近的醫院與診所（附官方來源），以及回國申請理賠必備的文件清單。
          </p>
        </div>
        <a
          href="/emergency"
          class="shrink-0 rounded-xl bg-red-600 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-red-700"
          >立刻查看 →</a
        >
      </div>
    </div>
  </section>

  <!-- 許願區 -->
  <section class="bg-panel">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div class="rounded-2xl border border-line bg-surface p-7 sm:p-10">
        <p class="text-xs font-black tracking-[0.2em] text-accent uppercase">Wishlist</p>
        <h2 class="mt-2 text-2xl font-black break-words text-head sm:text-3xl">
          想要什麼工具？寫下來
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed break-words text-muted">
          滑雪族群裡新手很多，每個人卡住的地方都不一樣。如果你想到某個「要是有個東西能幫我 OO
          就好了」的時刻，或是覺得現有的工具哪裡不順手，都歡迎寫在許願區 ——
          我會把最多人需要的做成工具。免註冊、可匿名。
        </p>
        <a
          href="/wishlist"
          class="mt-7 inline-block rounded-xl bg-white px-6 py-3.5 text-sm font-bold text-bg transition-colors hover:bg-accent"
          >去許願區 →</a
        >
      </div>
    </div>
  </section>

  <!-- 知識庫（外連到楊醫師個人網站） -->
  <section id="articles" class="scroll-mt-20 bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div class="rounded-2xl border border-line bg-panel p-7 sm:p-10">
        <p class="text-xs font-black tracking-[0.2em] text-accent uppercase">Knowledge</p>
        <h2 class="mt-2 text-2xl font-black break-words text-head sm:text-3xl">想知道背後的原理？</h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed break-words text-muted">
          這裡放的是「直接能用的工具」。至於這些判斷背後的傷害機轉、治療選擇與復健邏輯，
          楊醫師寫在他自己的網站上，內容更完整。
        </p>
        <a
          href={SITE_A.articlesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-block rounded-xl bg-white px-6 py-3.5 text-sm font-bold text-bg transition-colors hover:bg-accent"
          >前往衛教文章專區 →</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
