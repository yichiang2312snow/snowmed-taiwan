---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { SITE, SITE_A, TOOLS, TOOL_CATEGORIES } from '../consts';
import heroImage from '../assets/hero-ski-slope.jpg';
import VisitCounter from '../components/VisitCounter.astro';
import HeroPoll from '../components/HeroPoll.astro';
import PopularTools from '../components/PopularTools.astro';

---

<BaseLayout>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden bg-band text-head on-dark-photo light:bg-snow">
    <VisitCounter threshold={1000} />

    <Image
      src={heroImage}
      alt="高山雪場的滑雪道與纜車，遠方是連綿的雪山稜線"
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    {/*
      夜間模式蓋深藍色濾鏡；白天模式改成白色薄霧 ——
      雪地照片本來就是白的，不套藍色濾鏡才看得到雪原本的顏色，
      左側仍留較厚的白霧，深色的標題與內文才壓得住底下的樹與纜車。
    */}
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-band/96 via-band/90 to-band/70 light:from-white/92 light:via-white/78 light:to-white/40"
      aria-hidden="true"
    >
    </div>

    <div
      class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:py-24 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-center lg:gap-14 lg:py-28"
    >
      <div class="min-w-0">
      <h1 class="text-[1.75rem] leading-tight font-black sm:text-5xl lg:text-[3.4rem]">
        <span class="block">台灣滑雪運動醫學</span>
        <span class="block">科學平台</span>
      </h1>
      <p class="mt-3 text-xs font-medium text-accent sm:text-sm">
        {SITE.poweredBy}
      </p>

      <p class="mt-7 max-w-2xl text-lg leading-relaxed font-bold break-words text-head sm:text-xl">
        你可能還不認識我，但這裡有你出發滑雪前最需要的小工具。
      </p>

      <p class="mt-4 max-w-2xl text-base leading-relaxed break-words text-body sm:text-lg">
        第一次準備出國滑雪，是否覺得裝備、體能、海外保險排山倒海而來？這個網站專門為滑雪初心者與雪友打造——沒有複雜的理論，只有即點即用的互動小工具與防護清單，幫你省下摸索的力氣，安心享受雪地裡的每一步。
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#tools"
          class="rounded-xl bg-cta px-6 py-3.5 text-sm font-bold text-ctatext transition-colors hover:bg-accent"
          >直接開始用工具</a
        >
        <a
          href="/emergency"
          class="rounded-xl border border-linestrong px-6 py-3.5 text-sm font-bold text-head transition-colors hover:bg-tint1"
          >人在國外受傷了？</a
        >
      </div>
      </div>

      <!-- 一按進來就能玩的小投票 -->
      <div class="min-w-0 lg:justify-self-end lg:w-full">
        <HeroPoll />
      </div>
    </div>
  </section>

  <!-- 工具 -->
  <section id="tools" class="scroll-mt-20 bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-start">
        <div class="max-w-2xl">
          <p class="mb-2 text-xs font-bold tracking-[0.2em] text-accent uppercase">Tools</p>
          <h2 class="text-2xl font-black text-head sm:text-3xl">{TOOLS.length} 個滑雪醫學小工具</h2>
          <p class="mt-3 text-base leading-relaxed break-words text-muted">
            分成兩類：出發前準備與訓練用的，以及受傷了才需要看的。點進去就能用。
          </p>
        </div>
        {/* 累積到門檻之後才會出現的熱門排行 */}
        <PopularTools compact />
      </div>

      <div class="mt-12 space-y-14">
        {
          TOOL_CATEGORIES.map((cat) => (
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-4">
                <h3 class="text-xl font-black break-words text-head sm:text-2xl">
                  <span aria-hidden="true">{cat.emoji}</span> {cat.label}
                </h3>
                <p class="text-sm break-words text-muted">{cat.intro}</p>
              </div>

              <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {TOOLS.filter((t) => t.category === cat.id).map((t) => (
                  <ToolCard {...t} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 海外受傷緊急入口 -->
  <section class="bg-red-500/15">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:py-12">
      <div class="flex flex-wrap items-center justify-between gap-5 rounded-2xl border-2 border-red-500 bg-panel p-6 sm:p-8">
        <div class="min-w-0">
          <p class="text-xs font-black tracking-widest text-red-200 light:text-red-800 uppercase">Emergency</p>
          <h2 class="mt-2 text-xl font-black break-words text-head sm:text-2xl">
            人在國外雪場，受傷了？
          </h2>
          <p class="mt-2 max-w-xl text-sm leading-relaxed break-words text-muted">
            急救電話、PEACE &amp; LOVE 急性處置原則、日本主要雪場附近的醫院與診所（附官方來源），以及回國申請理賠必備的文件清單。
          </p>
        </div>
        <a
          href="/emergency"
          class="shrink-0 rounded-xl bg-red-600 px-6 py-3.5 text-sm font-bold text-white transition-colors hover:bg-red-700"
          >立刻查看 →</a
        >
      </div>
    </div>
  </section>

  <!-- 許願區 -->
  <section class="bg-panel">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div class="rounded-2xl border border-line bg-surface p-7 sm:p-10">
        <p class="text-xs font-black tracking-[0.2em] text-accent uppercase">Wishlist</p>
        <h2 class="mt-2 text-2xl font-black break-words text-head sm:text-3xl">
          想要什麼工具？寫下來
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed break-words text-muted">
          滑雪族群裡新手很多，每個人卡住的地方都不一樣。如果你想到某個「要是有個東西能幫我 OO
          就好了」的時刻，或是覺得現有的工具哪裡不順手，都歡迎寫在許願區 ——
          我會把最多人需要的做成工具。免註冊、可匿名。
        </p>
        <a
          href="/wishlist"
          class="mt-7 inline-block rounded-xl bg-cta px-6 py-3.5 text-sm font-bold text-ctatext transition-colors hover:bg-accent"
          >去許願區 →</a
        >
      </div>
    </div>
  </section>

  <!-- 知識庫（外連到楊醫師個人網站） -->
  <section id="articles" class="scroll-mt-20 bg-surface">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div class="rounded-2xl border border-line bg-panel p-7 sm:p-10">
        <p class="text-xs font-black tracking-[0.2em] text-accent uppercase">Knowledge</p>
        <h2 class="mt-2 text-2xl font-black break-words text-head sm:text-3xl">想知道背後的原理？</h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed break-words text-muted">
          這裡放的是「直接能用的工具」。至於這些判斷背後的傷害機轉、治療選擇與復健邏輯，
          楊醫師寫在他自己的網站上，內容更完整。
        </p>
        <a
          href={SITE_A.articlesUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-block rounded-xl bg-cta px-6 py-3.5 text-sm font-bold text-ctatext transition-colors hover:bg-accent"
          >前往衛教文章專區 →</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
