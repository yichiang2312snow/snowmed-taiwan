---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { RESORTS, EMERGENCY_NUMBER } from '../data/resorts';
import { SITE_A } from '../consts';

const whyNotIce = [
  {
    n: '1',
    title: '阻止了免疫細胞進駐',
    body: '巨噬細胞等修復因子無法順利到達受傷區域清創。',
  },
  {
    n: '2',
    title: '減緩新血管與膠原蛋白的生成',
    body: '延緩軟組織的實質修復速度。',
  },
  {
    n: '3',
    title: '增加軟組織疤痕化風險',
    body: '影響日後關節的靈活性與穩定度。',
  },
];

const peaceSteps = [
  {
    letter: 'P',
    word: 'Protect',
    zh: '保護',
    how: '立刻停止滑雪，避免二次傷害。',
    key: '前幾天限制患部活動，但避免長時間絕對固定 —— 適度微動比完全不動更好。',
  },
  {
    letter: 'E',
    word: 'Elevate',
    zh: '抬高',
    how: '將受傷的肢體抬高至高於心臟的位置。',
    key: '利用重力促進組織液回流，自然減輕腫脹。',
  },
  {
    letter: 'A',
    word: 'Avoid Anti-Inflammatory',
    zh: '避免非必要的消炎處置',
    how: '避免使用冰敷，以及非類固醇消炎止痛藥（NSAIDs）。',
    key: '保留身體正常的發炎修復機制。如果真的很痛，請在醫師指導下使用純止痛藥（如乙醯胺酚／普拿疼類），而非抗發炎藥物。',
    highlight: true,
  },
  {
    letter: 'C',
    word: 'Compress',
    zh: '壓迫',
    how: '使用彈性繃帶或護具對受傷區域適度加壓。',
    key: '限制關節內出血與組織腫脹，但注意不要綁太緊影響末梢血液循環。',
  },
  {
    letter: 'E',
    word: 'Educate',
    zh: '衛教與正向心態',
    how: '聽取專業醫學評估，避免主觀恐慌或進行非必要的過度醫療（如動輒要求開刀或強效注射）。',
    key: '相信身體的主動修復機制，心理狀態會顯著影響組織恢復速度。',
  },
];

const loveSteps = [
  {
    letter: 'L',
    word: 'Load',
    zh: '適度負載',
    how: '在不引起劇烈疼痛的前提下，逐步恢復患部的受力與活動。',
    key: '適當的機械應力（mechanical load）能刺激肌腱、韌帶與肌肉纖維規律重建。',
  },
  {
    letter: 'O',
    word: 'Optimism',
    zh: '保持樂觀',
    how: '積極面對復健過程。',
    key: '大腦與神經系統對疼痛的感知與心態高度相關，悲觀焦慮會增加神經對疼痛的敏感度。',
  },
  {
    letter: 'V',
    word: 'Vascularization',
    zh: '促進血管新生',
    how: '做無痛的全身性有氧運動（如定速健身車、快走）。',
    key: '增加全身血液循環，把氧氣與營養素送到受傷組織，同時帶走代謝廢物。',
  },
  {
    letter: 'E',
    word: 'Exercise',
    zh: '科學化運動復健',
    how: '針對性的肌力訓練、關節活動度與本體感覺（平衡）訓練。',
    key: '降低日後再次扭傷（習慣性復發、關節不穩定）的風險，為下一次重返雪場做好準備。',
  },
];

const claimDocs = [
  {
    id: 'diagnosis',
    label: '診斷證明書（正本）',
    detail:
      '要有醫師簽章、傷病名稱、就診日期。申請商業保險理賠和健保核退都需要。務必在當地就醫時就要求開立，回國後再要非常困難。',
    critical: true,
  },
  {
    id: 'receipt',
    label: '費用收據（正本）與費用明細',
    detail:
      '收據正本通常只有一份，而且健保與商業保險可能都要。請向醫院要「收據正本 + 費用明細」，必要時多開一份或請醫院蓋章證明。',
    critical: true,
  },
  {
    id: 'record',
    label: '病歷摘要或就醫紀錄',
    detail: '記錄受傷機轉與處置內容。回台灣接手的醫師會需要，理賠審查有時也會要求。',
  },
  {
    id: 'images',
    label: 'X 光／MRI 等影像光碟或檔案',
    detail:
      '影像本身比報告更有價值。回台灣後不必重照一次，省時間也省輻射與費用。離開前務必索取。',
    critical: true,
  },
  {
    id: 'passport',
    label: '護照影本與入出境紀錄',
    detail: '健保自墊核退需要證明就醫當下人在國外。',
  },
  {
    id: 'translation',
    label: '中文或英文翻譯本',
    detail: '日文診斷書回台灣申請時通常需要翻譯。部分國際診所可直接開英文版，開立時就先問。',
  },
  {
    id: 'policy',
    label: '保單號碼與保險公司海外聯絡電話',
    detail: '出發前就存進手機離線筆記。有些保單要求「就醫前先通知」才全額理賠。',
    critical: true,
  },
];
// 常見問題：問句就是大家實際會搜的字
const FAQ = [
  {
    q: '在日本滑雪受傷，第一通電話要打給誰？',
    a: '人還在雪道上，先找雪場巡邏隊（Ski Patrol）——他們比救護車更快到得了現場，而且有把人運下山的裝備。狀況危急撥 119。巡邏隊電話請在買雪票時就先問到並存進手機。',
  },
  {
    q: '日本的救護車要錢嗎？',
    a: '救護車本身免費，但後續的診察、檢查與治療費用要自付，回台灣後再向保險公司與健保申請核退。打通 119 後先說「救急車をお願いします」，再講地點。',
  },
  {
    q: '滑雪扭傷還要冰敷嗎？',
    a: '現行的運動醫學指引（2020 年 BJSM 的 PEACE & LOVE）已經不再把冰敷與消炎止痛藥當作常規處置，因為發炎反應是組織修復的第一步。急性期的重點是保護、適度負重、避免過度消炎；亞急性期則要促進血液循環與逐步活動。本頁上方有完整說明。',
  },
  {
    q: '回台灣申請保險理賠需要哪些文件？',
    a: '診斷證明書、醫療費用收據正本與費用明細，最好是英文或日文版本。最關鍵的一句話：這些全部要在當地、離開醫院前拿到，回台灣之後再跟日本的醫院要，難度會高很多，有些甚至要不到。收據正本只有一份，健保核退與商業保險要分配好。',
  },
  {
    q: '二世谷、白馬、湯澤附近有哪些醫院可以看運動傷害？',
    a: '本頁整理了湯澤、白馬、二世谷、星野 TOMAMU 四個區域鄰近的醫療機構，每一筆都附官方來源與查證日期。注意 TOMAMU 當地的村立診療所沒有整形外科，骨折韌帶要往富良野方向後送。',
  },
  {
    q: '受傷後回台灣該看哪一科？',
    a: '運動傷害一般看骨科或復健科；如果想要超音波影像檢查、增生治療與運動處方這類保守治療的完整評估，建議找熟悉滑雪運動的復健科醫師。有明顯變形、無法負重或劇烈麻木，請不要等回國，當地就要就醫。',
  },
];
---

<BaseLayout
  title="海外受傷緊急處置中心"
  seoTitle="在日本滑雪受傷怎麼辦？急救電話、雪場附近醫院與保險理賠文件"
  eyebrow="Emergency"
  description="在日本雪場受傷了怎麼辦？急救電話、PEACE & LOVE 急性處置原則（取代舊的 PRICE）、日本主要雪場（湯澤、白馬、二世谷、星野TOMAMU）附近的醫院與診所資訊，以及回國後申請健保核退與保險理賠需要的文件清單。"
>
  <!-- 緊急電話 -->
  <section class="bg-red-500/15">
    <div class="mx-auto max-w-3xl px-5 py-8">
      <p class="text-xs font-black tracking-widest text-red-200 light:text-red-800 uppercase">在日本，狀況危急時</p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <a
          href={`tel:${EMERGENCY_NUMBER.japan.number}`}
          class="block rounded-2xl border-2 border-red-500 bg-panel p-5 transition-colors hover:bg-red-500/15"
        >
          <p class="text-4xl font-black text-red-300">{EMERGENCY_NUMBER.japan.number}</p>
          <p class="mt-1 text-sm font-bold text-head">{EMERGENCY_NUMBER.japan.label}</p>
          <p class="mt-2 text-xs leading-relaxed break-words text-muted">
            {EMERGENCY_NUMBER.japan.note}
          </p>
        </a>
        <a
          href={`tel:${EMERGENCY_NUMBER.japanPolice.number}`}
          class="block rounded-2xl border border-line bg-panel p-5 transition-colors hover:bg-surface"
        >
          <p class="text-4xl font-black text-head">{EMERGENCY_NUMBER.japanPolice.number}</p>
          <p class="mt-1 text-sm font-bold text-head">{EMERGENCY_NUMBER.japanPolice.label}</p>
          <p class="mt-2 text-xs leading-relaxed break-words text-muted">
            {EMERGENCY_NUMBER.japanPolice.note}
          </p>
        </a>
      </div>
      <p class="mt-4 text-sm leading-relaxed break-words text-red-200 light:text-red-800">
        <strong>人還在雪道上的話，先找雪場巡邏隊（Ski Patrol）</strong>
        —— 他們比救護車更快到得了現場，而且有把人從雪道運下山的裝備。巡邏隊電話請在買雪票時就先問到並存進手機。
      </p>
    </div>
  </section>

  <!-- 分流入口 -->
  <section class="bg-band text-white on-dark">
    <div class="mx-auto max-w-3xl px-5 py-10">
      <h2 class="text-xl font-black">不確定嚴不嚴重？</h2>
      <p class="mt-2 text-sm leading-relaxed break-words text-body">
        用紅黃綠燈分流工具，兩分鐘判斷該叫巡邏隊、該當地就醫，還是可以先觀察。
      </p>
      <a
        href="/tools/injury-triage"
        class="mt-5 inline-block rounded-xl bg-panel px-6 py-3.5 text-sm font-bold text-head hover:bg-tint2"
        >開始判斷 →</a
      >
    </div>
  </section>

  <!-- 觀念翻轉 -->
  <section id="peace-love" class="scroll-mt-20 bg-panel">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
      <p class="text-xs font-black tracking-[0.2em] text-accent uppercase">Acute care</p>
      <h2 class="mt-2 text-2xl leading-snug font-black break-words text-head sm:text-3xl">
        滑雪受傷別再急著冰敷
      </h2>
      <p class="mt-2 text-base font-bold break-words text-accent sm:text-lg">
        從 PRICE 到 PEACE &amp; LOVE：運動醫學最新的扭傷處置指南
      </p>

      <div class="prose-tc mt-6 text-muted">
        <p>
          出國滑雪最怕遇到突發意外 —— 下坡失控摔倒、膝蓋扭到、扭傷手腕或腰部挫傷。
        </p>
        <p>
          過去幾十年來，大家耳熟能詳的急性運動傷害處理口訣是
          <strong>PRICE</strong>（保護 Protect、休息 Rest、冰敷 Ice、壓迫 Compress、抬高
          Elevate）。然而，最新的運動醫學研究已經正式翻轉了這個觀念。
        </p>
        <p>
          現在國際權威醫學期刊（如《英國運動醫學雜誌》BJSM）全面推薦全新的
          <strong>PEACE &amp; LOVE</strong> 原則。我們不再提倡「一味消炎止痛」，而是強調<strong
            >促進自然癒合</strong
          >，讓受傷部位更快回歸最佳狀態。
        </p>
      </div>

      <!-- 為什麼 PRICE 退流行 -->
      <div class="mt-10 rounded-2xl border border-line bg-surface p-6 sm:p-8">
        <h3 class="text-lg leading-snug font-black break-words text-head">
          為什麼 PRICE 已經退流行？
        </h3>
        <p class="mt-1 text-sm font-bold break-words text-accent">
          「冰敷與過度消炎」其實會延緩癒合
        </p>

        <div class="prose-tc mt-4 text-muted">
          <p>
            過去我們認為受傷後的「腫脹與發炎」是壞事，所以急著用冰敷（Ice）和非類固醇消炎止痛藥（NSAIDs）把發炎壓下去。
          </p>
          <p>
            但現代解剖學與組織修復研究發現：<strong>發炎反應，其實是身體修復組織的第一步。</strong>
          </p>
          <p>當你冰敷或吃強效消炎藥時，血管會劇烈收縮，雖然暫時減輕了腫脹感，但也同時：</p>
        </div>

        <ol class="mt-4 space-y-3">
          {
            whyNotIce.map((w) => (
              <li class="flex min-w-0 gap-3.5 rounded-xl border border-line bg-panel p-4">
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-red-500/25 text-sm font-black text-red-200 light:text-red-800"
                  aria-hidden="true"
                >
                  {w.n}
                </span>
                <div class="min-w-0">
                  <p class="text-sm font-bold break-words text-head">{w.title}</p>
                  <p class="mt-1 text-sm leading-relaxed break-words text-muted">{w.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <p class="mt-5 rounded-xl bg-tint2 px-4 py-3 text-sm leading-relaxed break-words text-head">
          因此，現代滑雪運動醫學主張：<strong>急性期順應發炎、亞急性期促進血液循環。</strong>
        </p>
      </div>

      <!-- PEACE -->
      <div class="mt-12">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-xl font-black text-head sm:text-2xl">急性期：PEACE</h3>
          <span class="text-sm text-muted">剛受傷 1–3 天</span>
        </div>
        <p class="mt-2 text-sm leading-relaxed break-words text-muted">
          當你在雪地上剛剛扭傷或挫傷時，前 72 小時請給予患部 <strong class="text-head">PEACE</strong
          >（和平相處）。
        </p>

        <ol class="mt-6 space-y-3">
          {
            peaceSteps.map((s) => (
              <li
                class:list={[
                  'flex min-w-0 gap-4 rounded-2xl border p-5',
                  s.highlight ? 'border-red-300 bg-red-500/15' : 'border-line bg-surface',
                ]}
              >
                <span
                  class:list={[
                    'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-xl font-black',
                    s.highlight ? 'bg-red-600 text-white' : 'bg-band text-accent2',
                  ]}
                  aria-hidden="true"
                >
                  {s.letter}
                </span>
                <div class="min-w-0">
                  <p class="font-bold break-words text-head">
                    {s.zh}
                    <span class="ml-2 text-xs font-medium break-words text-muted">
                      {s.word}
                    </span>
                  </p>
                  <p class="mt-2 text-sm leading-relaxed break-words text-head">
                    <span class="font-bold text-accent">作法：</span>
                    {s.how}
                  </p>
                  <p class="mt-1.5 text-sm leading-relaxed break-words text-muted">
                    <span class="font-bold text-accent">重點：</span>
                    {s.key}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- LOVE -->
      <div class="mt-12">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-xl font-black text-head sm:text-2xl">亞急性期：LOVE</h3>
          <span class="text-sm text-muted">受傷 3 天後</span>
        </div>
        <p class="mt-2 text-sm leading-relaxed break-words text-muted">
          當急性劇烈疼痛與大面積腫脹趨緩後，患部需要的是 <strong class="text-head">LOVE</strong
          >（愛與活化），讓軟組織重新建構。
        </p>

        <ol class="mt-6 space-y-3">
          {
            loveSteps.map((s) => (
              <li class="flex min-w-0 gap-4 rounded-2xl border border-line bg-surface p-5">
                <span
                  class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-cta text-xl font-black text-ctatext"
                  aria-hidden="true"
                >
                  {s.letter}
                </span>
                <div class="min-w-0">
                  <p class="font-bold break-words text-head">
                    {s.zh}
                    <span class="ml-2 text-xs font-medium break-words text-muted">
                      {s.word}
                    </span>
                  </p>
                  <p class="mt-2 text-sm leading-relaxed break-words text-head">
                    <span class="font-bold text-accent">作法：</span>
                    {s.how}
                  </p>
                  <p class="mt-1.5 text-sm leading-relaxed break-words text-muted">
                    <span class="font-bold text-accent">重點：</span>
                    {s.key}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- 醫師叮嚀 -->
      <div class="mt-12 rounded-2xl border-l-4 border-accent bg-tint1 p-6 sm:p-8">
        <h3 class="text-lg font-black text-head">復健科醫師的叮嚀</h3>
        <div class="prose-tc mt-3 text-muted">
          <p>
            雪場上的運動傷害不可怕，可怕的是用了<strong>過時的方法處理</strong>，導致組織修復不完全，留下長期的關節隱患。
          </p>
          <p>
            如果在雪場受傷後出現<strong>無法負重行走、關節顯著變形、劇烈麻木感，或持續無法消退的劇痛</strong>，請務必第一時間尋求雪場醫務室或當地醫療機構的診斷。
          </p>
          <p>
            回國後，也建議尋求熟悉極限與滑雪運動的復健科醫師進行超音波影像檢查與結構評估，透過增生治療、運動處方與科學化復健，讓身體真正「高質量」地痊癒。
          </p>
        </div>
      </div>

      <!-- 出處 -->
      <div class="mt-8 rounded-2xl border border-line bg-surface p-5">
        <p class="text-xs leading-relaxed break-words text-muted">
          <strong class="text-head">這一段的依據：</strong>
          PEACE &amp; LOVE 原則出自 Dubois B, Esculier JF.
          <em>Soft-tissue injuries simply need PEACE and LOVE.</em>
          <span class="whitespace-nowrap">Br J Sports Med. 2020;54(2):72–73.</span>
          <a
            href="https://pubmed.ncbi.nlm.nih.gov/31377722/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-accent underline underline-offset-2">PubMed 31377722</a
          >
          ·
          <a
            href="https://doi.org/10.1136/bjsports-2019-101253"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-accent underline underline-offset-2">doi:10.1136/bjsports-2019-101253</a
          >
        </p>
        <p class="mt-2 text-xs leading-relaxed break-words text-muted">
          冰敷在臨床上仍常被用來短期止痛，學界對它的角色也還有討論空間。本頁採用的是 PEACE &amp;
          LOVE 的立場：<strong class="text-head">不要為了壓制發炎而冰敷</strong
          >。如果你的醫師基於你的具體狀況給了不同建議，請以醫師的判斷為準。
        </p>
      </div>
    </div>
  </section>

  <!-- 雪場醫療資訊 -->
  <section id="resorts" class="scroll-mt-20 bg-surface">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
      <h2 class="text-2xl font-black text-head">日本主要雪場的醫療機構</h2>
      <p class="mt-3 text-sm leading-relaxed break-words text-muted">
        每一筆資料都附上官方來源連結與查證日期。<strong class="text-head"
          >雪季門診時間每年都會變動，出發前請務必自己再確認一次</strong
        >，並在買雪票時問到雪場巡邏隊的電話。
      </p>

      <div class="mt-8 flex flex-wrap gap-2">
        {
          RESORTS.map((r) => (
            <a
              href={`#${r.id}`}
              class="rounded-full border border-line bg-panel px-4 py-2 text-sm font-bold text-head hover:border-accent hover:bg-tint1"
            >
              {r.name}
            </a>
          ))
        }
      </div>

      <div class="mt-10 space-y-10">
        {
          RESORTS.map((r) => (
            <article id={r.id} class="scroll-mt-20">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-xl font-black break-words text-head">{r.name}</h3>
                <span class="text-sm text-muted">{r.nameJa}</span>
              </div>
              <p class="mt-1 text-xs text-muted">{r.area}</p>

              <p class="mt-2 text-xs break-words text-muted">
                涵蓋雪場：{r.resorts.join('、')}
              </p>

              <p class="mt-4 rounded-xl bg-tint1 px-4 py-3 text-sm leading-relaxed break-words text-head">
                {r.note}
              </p>

              <div class="mt-5 space-y-4">
                {r.facilities.map((f) => (
                  <div class="min-w-0 overflow-hidden rounded-2xl border border-line bg-panel">
                    <div class="border-b border-line bg-surface px-5 py-3">
                      <div class="flex flex-wrap items-center gap-2">
                        <span
                          class:list={[
                            'rounded-full px-2.5 py-0.5 text-[11px] font-bold',
                            f.type === 'hospital' ? 'bg-band text-white on-dark' : 'bg-tint2 text-head',
                          ]}
                        >
                          {f.type === 'hospital' ? '綜合醫院' : '診所'}
                        </span>
                        {f.languages && (
                          <span class="rounded-full bg-emerald-500/25 px-2.5 py-0.5 text-[11px] font-bold text-emerald-200 light:text-emerald-800">
                            {f.languages}
                          </span>
                        )}
                      </div>
                      <p class="mt-2 font-black break-words text-head">{f.name}</p>
                      {f.nameEn && <p class="text-xs break-words text-muted">{f.nameEn}</p>}
                    </div>

                    <dl class="divide-y divide-line text-sm">
                      <div class="flex min-w-0 gap-3 px-5 py-3">
                        <dt class="w-14 shrink-0 text-xs font-bold text-muted">地址</dt>
                        <dd class="min-w-0 break-words text-head">{f.address}</dd>
                      </div>
                      <div class="flex min-w-0 gap-3 px-5 py-3">
                        <dt class="w-14 shrink-0 text-xs font-bold text-muted">電話</dt>
                        <dd class="min-w-0">
                          <a
                            href={`tel:${f.phone.replace(/-/g, '')}`}
                            class="font-bold text-accent underline underline-offset-2"
                          >
                            {f.phone}
                          </a>
                        </dd>
                      </div>
                      <div class="flex min-w-0 gap-3 px-5 py-3">
                        <dt class="w-14 shrink-0 text-xs font-bold text-muted">科別</dt>
                        <dd class="min-w-0 break-words text-head">{f.departments}</dd>
                      </div>
                      {f.hours && (
                        <div class="flex min-w-0 gap-3 px-5 py-3">
                          <dt class="w-14 shrink-0 text-xs font-bold text-muted">時間</dt>
                          <dd class="min-w-0 break-words text-head">{f.hours}</dd>
                        </div>
                      )}
                      {f.note && (
                        <div class="px-5 py-3">
                          <p class="text-xs leading-relaxed break-words text-muted">{f.note}</p>
                        </div>
                      )}
                    </dl>

                    <div class="border-t border-line bg-surface px-5 py-2.5">
                      <p class="text-[11px] break-words text-muted">
                        資料來源：
                        <a
                          href={f.source}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-accent underline underline-offset-2"
                        >
                          {f.sourceLabel}
                        </a>
                        <span class="text-muted/70"> · 查證日期 {f.checkedAt}</span>
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl border-l-4 border-accent bg-panel p-6">
        <p class="text-sm leading-relaxed break-words text-muted">
          <strong class="text-head">還沒有你要去的雪場？</strong>
          這份清單會持續增加。你可以到
          <a href="/wishlist" class="font-bold text-accent hover:underline">許願留言區</a>
          告訴我你想看哪個雪場，我會優先查證那一區。
        </p>
      </div>
    </div>
  </section>

  <!-- 理賠 checklist -->
  <section class="bg-panel">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
      <h2 class="text-2xl font-black text-head">回國後要申請理賠，這些文件缺一不可</h2>
      <p class="mt-3 text-sm leading-relaxed break-words text-muted">
        <strong class="text-head">最關鍵的一句話：這些東西全部都要在當地、離開醫院前拿到。</strong>
        回台灣之後再跟日本的醫院要，難度會高很多，有些甚至要不到。勾選狀態會存在你的瀏覽器裡。
      </p>

      <ul class="mt-8 space-y-2.5">
        {
          claimDocs.map((d) => (
            <li class="min-w-0 overflow-hidden rounded-xl border border-line bg-surface">
              <label class="flex min-w-0 cursor-pointer items-start gap-3 p-4">
                <input
                  type="checkbox"
                  data-claim
                  value={d.id}
                  class="mt-1 h-4.5 w-4.5 shrink-0 accent-[var(--color-accent)]"
                />
                <span class="min-w-0">
                  <span class="block text-sm leading-relaxed font-medium break-words text-head">
                    {d.label}
                    {d.critical && (
                      <span class="ml-2 rounded-full bg-tint2 px-2 py-0.5 align-middle text-[10px] font-bold whitespace-nowrap text-head">
                        必備
                      </span>
                    )}
                  </span>
                  <span class="mt-1.5 block text-xs leading-relaxed break-words text-muted">
                    {d.detail}
                  </span>
                </span>
              </label>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 rounded-2xl border border-line bg-surface p-6">
        <h3 class="font-black text-head">兩個很容易踩的坑</h3>
        <ul class="mt-3 space-y-3 text-sm leading-relaxed break-words text-muted">
          <li>
            <strong class="text-head">1. 滑雪可能不在你的保單涵蓋範圍內。</strong>
            滑雪在部分旅平險被列為高風險活動，要另外加購才理賠。出發前一定要跟保險公司確認「滑雪／冬季運動」有沒有被排除。
          </li>
          <li>
            <strong class="text-head">2. 收據正本只有一份。</strong>
            健保自墊核退和商業保險理賠可能都要正本。請在醫院就先問能不能多開一份，或請保險公司接受「正本查驗後退還」。
          </li>
        </ul>
      </div>

      <p class="mt-6 text-xs leading-relaxed break-words text-muted">
        以上為一般性的流程整理，不構成保險建議。各家保單條款不同、健保核退的規定也會修訂，實際請以保險公司與衛生福利部中央健康保險署的公告為準。
      </p>
    </div>
  </section>

  <!-- 導流 -->
  <section class="bg-surface">
    <div class="mx-auto max-w-3xl px-5 py-12 sm:py-16">
      <Faq items={FAQ} />
    </div>
  </section>

  <section class="bg-tint1">
    <div class="mx-auto max-w-3xl px-5 py-10">
      <p class="text-sm leading-relaxed break-words text-muted">
        <strong class="text-head">想了解這些處置背後的醫學原理？</strong>
        本站的判斷邏輯參考運動醫學的臨床處置原則。更深入的傷害機轉說明，可以參考
        <a href="/ski-medicine" class="font-bold text-accent hover:underline">滑雪傷害圖鑑</a>
        與
        <a
          href={SITE_A.url}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-accent hover:underline">{SITE_A.label}</a
        >。
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const KEY = 'snowmed:claim-docs';
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-claim]'));

  if (boxes.length) {
    try {
      const saved = JSON.parse(localStorage.getItem(KEY) ?? '[]') as string[];
      for (const b of boxes) if (saved.includes(b.value)) b.checked = true;
    } catch {
      /* 讀不到就當作沒有勾過 */
    }

    for (const b of boxes) {
      b.addEventListener('change', () => {
        try {
          localStorage.setItem(
            KEY,
            JSON.stringify(boxes.filter((x) => x.checked).map((x) => x.value))
          );
        } catch {
          /* 無痕模式等情況忽略 */
        }
      });
    }
  }
</script>
