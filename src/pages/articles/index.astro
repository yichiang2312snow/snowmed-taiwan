---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { lastUpdated } from '../../lib/lastUpdated';
import { formatDate } from '../../lib/format';

// 文章清單在建置時就寫進 HTML，不是靠 JavaScript 讀 JSON 生出來
const posts = (await getCollection('articles', ({ data }) => !data.draft))
  .map((entry) => {
    const updated = lastUpdated(entry.filePath);
    return {
      entry,
      updated,
      sortKey: Math.max(entry.data.date.valueOf(), updated?.valueOf() ?? 0),
    };
  })
  .sort((a, b) => b.sortKey - a.sortKey);

const siteUpdated = posts.length > 0 ? new Date(posts[0].sortKey) : null;
const categories = [...new Set(posts.map((p) => p.entry.data.category))];
---

<BaseLayout
  title="知識庫"
  eyebrow="Knowledge"
  description="滑雪運動醫學知識庫：傷害預防、運動傷害、體能訓練與回歸雪場的衛教文章。每一篇都標明作者與最後更新日期。"
>
  <section class="bg-panel">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <p class="max-w-2xl text-base leading-relaxed break-words text-muted">
          工具告訴你「該怎麼做」，這裡解釋「為什麼」。每一篇都標明發佈與最後更新日期，你可以自己判斷內容新不新。
        </p>
        {
          siteUpdated && (
            <p class="shrink-0 text-xs text-muted">
              共 {posts.length} 篇 · 最後更新 {formatDate(siteUpdated)}
            </p>
          )
        }
      </div>

      {
        categories.length > 1 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {categories.map((c) => (
              <span class="rounded-full border border-line bg-surface px-3 py-1.5 text-xs font-bold text-head">
                {c}
              </span>
            ))}
          </div>
        )
      }

      {
        posts.length > 0 ? (
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map(({ entry, updated }) => (
              <ArticleCard
                slug={entry.id}
                title={entry.data.title}
                description={entry.data.description}
                date={entry.data.date}
                updated={updated}
                author={entry.data.author}
                category={entry.data.category}
                image={entry.data.heroImage}
                imageAlt={entry.data.heroAlt}
              />
            ))}
          </div>
        ) : (
          <p class="mt-10 rounded-2xl border-2 border-dashed border-line bg-surface p-10 text-center text-sm text-muted">
            還沒有文章。
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
