---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { SITE_A } from '../../consts';
import { TRAINING_ARTICLE_LOG, TRAINING_LAST_CHECKED } from '../../data/trainingPlan';

// 這一頁依據的文章，直接從對照紀錄產生，新增依據文章時「根據什麼做的」那段會自動跟著變
const sources = TRAINING_ARTICLE_LOG.filter((a) => a.use !== 'none');
const USE_LABEL: Record<string, string> = { common: '通用課表', ski: '雙板專項', snowboard: '單板專項' };
---

<ToolLayout
  title="行前肌力＆體能訓練計畫產生器"
  emoji="📅"
  time="約 1 分鐘"
  summary="輸入出發日期、滑的是單板還是雙板，以及目前的運動習慣，自動排出從今天到出發前的分期訓練行程。可以直接列印或截圖存起來。"
  description="輸入滑雪出發日期與板種，自動產生分期的行前訓練計畫：肌力打底、離心轉化、平衡專項到出發前減量。雙板加上單腿控制與重心轉移的專項動作，單板加上抗旋轉的專項動作。"
>
  <form id="plan-form" class="space-y-6">
    <div class="min-w-0 rounded-2xl border border-line bg-surface p-5 sm:p-6">
      <label for="departure" class="block text-sm font-bold text-head">出發日期</label>
      <p class="mt-1 text-xs text-muted">你這趟滑雪行程的第一天。</p>
      <input
        type="date"
        id="departure"
        name="departure"
        required
        class="mt-3 w-full rounded-xl border border-line bg-panel px-4 py-3 text-base text-head focus:border-accent focus:outline-none"
      />
    </div>

    <fieldset class="min-w-0 rounded-2xl border border-line bg-surface p-5 sm:p-6">
      <legend class="px-2 text-sm font-bold text-head">你滑的是</legend>
      <p class="mt-1 text-xs text-muted">
        選了之後，會在通用課表上多排幾個專項動作。雙板練的是單腿控制、左右腳之間的重心轉移，以及「上身不動、下身轉」；單板練的是抗旋轉，也就是「骨盆穩住、上半身獨立轉動」。兩種都滑的人，選這一趟主要會滑的那一種。
      </p>
      <div class="mt-4 grid gap-2 sm:grid-cols-2">
        {
          [
            { v: 'ski', label: '雙板（ski）' },
            { v: 'snowboard', label: '單板（snowboard）' },
          ].map((o) => (
            <label class="flex min-w-0 cursor-pointer items-center gap-3 rounded-xl border border-line bg-panel px-4 py-3 text-sm transition-colors has-[:checked]:border-accent has-[:checked]:bg-tint2">
              <input
                type="radio"
                name="board"
                value={o.v}
                required
                class="h-4 w-4 shrink-0 accent-[var(--color-accent)]"
              />
              <span class="min-w-0 break-words text-head">{o.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset class="min-w-0 rounded-2xl border border-line bg-surface p-5 sm:p-6">
      <legend class="px-2 text-sm font-bold text-head">目前的運動習慣</legend>
      <p class="mt-1 text-xs text-muted">誠實一點，計畫才會有用。</p>
      <div class="mt-4 grid gap-2">
        {
          [
            { v: 'none', label: '幾乎沒有規律運動' },
            { v: 'light', label: '偶爾運動，每週不到 2 次' },
            { v: 'regular', label: '規律運動，每週 2–3 次' },
            { v: 'active', label: '運動習慣很好，每週 4 次以上' },
          ].map((o) => (
            <label class="flex min-w-0 cursor-pointer items-center gap-3 rounded-xl border border-line bg-panel px-4 py-3 text-sm transition-colors has-[:checked]:border-accent has-[:checked]:bg-tint2">
              <input
                type="radio"
                name="level"
                value={o.v}
                required
                class="h-4 w-4 shrink-0 accent-[var(--color-accent)]"
              />
              <span class="min-w-0 break-words text-head">{o.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <button
      type="submit"
      class="w-full rounded-xl bg-cta px-6 py-4 text-sm font-bold text-ctatext transition-colors hover:bg-accent"
    >
      產生我的訓練計畫
    </button>
  </form>

  <p id="plan-error" class="mt-4 rounded-xl bg-tint2 px-4 py-3 text-sm font-bold text-head" hidden>
  </p>

  <div id="plan-result" class="mt-10 scroll-mt-20" hidden>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs font-black tracking-widest text-accent uppercase">你的計畫</p>
        <h2 id="plan-title" class="mt-1 text-xl font-black break-words text-head sm:text-2xl"></h2>
      </div>
      <button
        type="button"
        id="plan-print"
        class="shrink-0 rounded-xl border border-line bg-panel px-4 py-2.5 text-sm font-bold text-head hover:bg-tint1 print:hidden"
        >列印 / 存成 PDF</button
      >
    </div>

    <p id="plan-note" class="mt-3 text-sm leading-relaxed break-words text-muted"></p>

    <div id="plan-weeks" class="mt-7 space-y-4"></div>

    <div class="mt-6 min-w-0 rounded-2xl border border-line bg-surface p-5 sm:p-6">
      <h3 class="text-lg font-black break-words text-head">練到什麼程度算夠？</h3>
      <p class="mt-2 text-sm leading-relaxed break-words text-muted">
        不用猜，出發前用這幾個標準自己檢查一次。做不到的那一項，就是你最後幾週該加強的地方。
      </p>
      <ul id="plan-checks" class="mt-4 space-y-2"></ul>
    </div>

    <div class="mt-6 rounded-2xl border-l-4 border-accent bg-tint1 p-5 sm:p-6">
      <p class="text-sm leading-relaxed break-words text-head">
        以上僅為依據所剩時間分配的<strong>基礎訓練課表</strong>，詳細客製化的訓練內容，還是需要依據每個人的運動強度基底以及姿勢熟悉度去做調整。
        另外，若無專業教練指導，嘗試新的運動動作也有受傷的風險，建議有疑慮的滑雪愛好者<strong>先請專家評估過再開始訓練</strong>。
      </p>
    </div>

    <div class="mt-8 rounded-2xl border border-line bg-surface p-6 print:hidden">
      <p class="text-sm font-bold text-head">不確定自己現在的程度？</p>
      <p class="mt-2 text-sm leading-relaxed break-words text-muted">
        先做一次<a href="/tools/fitness-check" class="font-bold text-accent hover:underline"
          >行前體能自我檢測</a
        >，它會告訴你五項能力裡最弱的是哪一項，訓練時就知道該把重點放在哪。
      </p>
    </div>
  </div>

  <Fragment slot="basis">
    <p>
      計畫的骨架是運動訓練常用的<strong>分期概念（periodization）</strong>：先建立基礎肌力，再把肌力轉化成該項運動實際需要的形式，最後做專項與減量。
    </p>
    <p>
      對應到滑雪，四個階段分別處理的是：<strong>基礎肌力</strong>（撐得住負荷）→
      <strong>離心與單側能力</strong>（滑雪整天都在煞車，而且是單腳輪流承重）→
      <strong>平衡與落地控制</strong>（面對突發雪況的反應）→
      <strong>減量恢復</strong>（讓身體在出發時是新鮮的）。
    </p>
    <p>
      完整的準備期是三個月的週期化訓練，但多數人沒有這麼多時間，所以這裡以 8 週為基準 —— 肌力訓練通常需要 6–8
      週才會產生可測量的改變。如果你剩下的時間比較短，計畫會自動壓縮，並把重點移到進步最快的項目（平衡與落地控制）；只剩一兩週時，會改成不排肌力與跳躍的短期方案。
    </p>
    <p>
      「目前運動習慣」只影響<strong>起始強度與每週次數</strong>，不改變階段順序 ——
      順序本身對每個人都一樣。
    </p>
    <p>
      選<strong>雙板</strong>時多出來的動作，練的是四件事：<strong>保護十字韌帶、單腿控制、下半身主動旋轉、左右腳交互的重心轉移</strong>。雙板的每一個轉彎，體重都從一隻腳移到另一隻腳、由外側腳單獨扛住；做小轉時則是上身不動、雙腿在身體下方轉動，這個轉動應該來自髖關節而不是膝蓋。
    </p>
    <p>
      選<strong>單板</strong>時多出來的動作，練的是<strong>抗旋轉與上下半身分離</strong>：單板雙腳固定在同一塊板上、身體側向站立，換刃時由上半身帶出方向，骨盆以下要穩住；雪包和壓雪車的痕跡又會突然給板子一個扭力，軀幹得擋得住。
    </p>
    <p>
      兩種專項都是<strong>疊在通用課表之上的補強，不是另一份課表</strong>，照頁面排好的這一份做就可以，不需要把幾篇文章的課表全部加起來做。
    </p>
    <p>動作內容與分期都出自楊醫師的文章：</p>
    <ul>
      {
        sources.map((a) => (
          <li>
            <a href={`${SITE_A.url}articles/${a.slug}`} target="_blank" rel="noopener">
              〈{a.title}〉
            </a>
            —— {USE_LABEL[a.use]}的依據
          </li>
        ))
      }
    </ul>
    <p>
      想知道每個動作的做法、最常見的錯誤，以及什麼情況下不要自己練，請讀原文。這一頁會定期對照楊醫師新發表或修訂過的訓練文章，內容有出入時以文章為準並修訂這裡；上次對照：{TRAINING_LAST_CHECKED}。
    </p>
  </Fragment>

  <Fragment slot="limits">
    <ul>
      <li>
        <strong>這是通用範本，不是個別化處方。</strong>
        它不知道你的舊傷、手術病史、關節活動度或工作型態，而這些都會改變合理的訓練內容。
      </li>
      <li>
        <strong>有疼痛就不要照著做。</strong>
        訓練時出現關節疼痛（不是肌肉酸痛）、腫脹或不穩定感，請停下來並就醫。
      </li>
      <li>
        <strong>動作品質永遠優先於次數。</strong>
        單腳蹲做 10 下但膝蓋一直往內塌，比做 3 下但控制得好還糟糕 —— 後者在練保護，前者在練受傷。
      </li>
      <li>
        <strong>有心血管疾病、控制不良的慢性病，或懷孕中，開始任何新的訓練前請先諮詢醫師。</strong>
      </li>
      <li>
        <strong>練完不等於不會受傷。</strong>
        體能只降低風險，不消除風險。雪場上的速度控制、地形選擇和疲勞管理，影響同樣大。
      </li>
    </ul>
  </Fragment>
</ToolLayout>

<script>
  import { BOARD_LABEL, CHECKS, PHASES, SHORT_PHASE } from '../../data/trainingPlan';
  import type { Board, Phase } from '../../data/trainingPlan';

  const form = document.getElementById('plan-form') as HTMLFormElement | null;
  const result = document.getElementById('plan-result');
  const errorBox = document.getElementById('plan-error');

  // 從首頁投票的「預計幾月幾號出發」過來時，網址會帶 ?date=YYYY-MM-DD，
  // 直接幫他填好出發日期，少打一次。
  const dateParam = new URLSearchParams(location.search).get('date') ?? '';
  if (/^\d{4}-\d{2}-\d{2}$/.test(dateParam)) {
    const dep = document.getElementById('departure') as HTMLInputElement | null;
    if (dep && !dep.value) dep.value = dateParam;
  }

  if (form && result) {
    // 動作、組數與自我檢查標準都在 src/data/trainingPlan.ts（依楊醫師的文章整理，文章更新時只改那裡）

    const FREQ: Record<string, { label: string; note: string; perWeek: string }> = {
      none: {
        label: '幾乎沒有規律運動',
        note: '你從零開始，所以第一階段會拉長一點，前兩週請用徒手、低強度進行，讓身體適應。寧可慢，不要一開始就練到受傷。',
        perWeek: '每週 2 次',
      },
      light: {
        label: '偶爾運動',
        note: '你有一點基礎，但需要建立規律。重點是「有做到」而不是「做很重」，把頻率穩定下來最重要。',
        perWeek: '每週 2–3 次',
      },
      regular: {
        label: '規律運動',
        note: '你的基礎足夠，可以照標準進度走。重點放在單側動作和離心訓練 —— 這兩項是一般健身最容易忽略、但滑雪最需要的。',
        perWeek: '每週 3 次',
      },
      active: {
        label: '運動習慣很好',
        note: '你的體能基礎不錯，可以把重量和難度往上加。特別注意平衡與落地控制，這是很多體能好的人反而疏忽的部分。',
        perWeek: '每週 3–4 次',
      },
    };

    const fmt = (d: Date) =>
      d.toLocaleDateString('zh-TW', { month: 'numeric', day: 'numeric' }).replace(/\//g, '/');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const dep = String(data.get('departure') ?? '');
      const level = String(data.get('level') ?? '');
      const boardRaw = String(data.get('board') ?? '');
      if (!dep || !level || !boardRaw) return;
      const board: Board = boardRaw === 'snowboard' ? 'snowboard' : 'ski';
      const boardLabel = BOARD_LABEL[board];
      const tagText = `${boardLabel}專項`;

      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const departure = new Date(dep + 'T00:00:00');

      const days = Math.round((departure.valueOf() - today.valueOf()) / 86400000);

      const showError = (msg: string) => {
        if (errorBox) {
          errorBox.textContent = msg;
          errorBox.hidden = false;
        }
        result.hidden = true;
      };

      if (days < 0) {
        showError('出發日期看起來已經過了。請改成未來的日期。');
        return;
      }
      if (days < 7) {
        showError(
          '距離出發不到一週了。這個時候開始練肌力來不及，反而可能帶著酸痛上雪場。建議：這幾天只做伸展和輕度平衡練習、睡飽，然後在雪場上主動降低強度、每天提早收工。'
        );
        return;
      }
      if (errorBox) errorBox.hidden = true;

      const totalWeeks = Math.min(Math.floor(days / 7), 12);

      // 只剩一兩週：三篇文章的說法一致 —— 肌力來不及長，不排肌力與跳躍，改成每天做的輕量控制練習
      const isShort = totalWeeks <= 2;

      // 依剩餘週數分配四個階段的長度（減量期固定 1 週）
      let alloc: number[];
      if (isShort) {
        alloc = [0, 0, 0, 0];
      } else if (totalWeeks >= 8) {
        const taper = 1;
        const rest = totalWeeks - taper;
        const base = Math.round(rest * 0.375);
        const convert = Math.round(rest * 0.375);
        alloc = [base, convert, rest - base - convert, taper];
      } else if (totalWeeks >= 5) {
        const taper = 1;
        const rest = totalWeeks - taper;
        const base = Math.floor(rest / 3);
        const convert = Math.floor(rest / 3);
        alloc = [base, convert, rest - base - convert, taper];
      } else {
        // 時間很短：跳過打底，直接轉化 + 專項
        alloc = [0, totalWeeks - 2, 1, 1];
      }
      const plan: Array<{ phase: Phase; len: number }> = isShort
        ? [{ phase: SHORT_PHASE, len: totalWeeks }]
        : PHASES.map((phase, i) => ({ phase, len: alloc[i] }));

      const freq = FREQ[level];

      const title = document.getElementById('plan-title');
      if (title) {
        title.textContent = isShort
          ? `${boardLabel} · 距離出發還有 ${days} 天 · 短期方案`
          : `${boardLabel} · 距離出發還有 ${days} 天 · 共 ${totalWeeks} 週的計畫`;
      }

      const note = document.getElementById('plan-note');
      if (note) {
        // 短期方案不分程度：每個人都是每天做輕量的控制練習，所以不套用「依運動習慣加重」的說明
        let text = isShort
          ? `距離出發只剩 ${days} 天，肌力來不及長，所以這份計畫不排肌力與跳躍，只留每天做的平衡與動作控制練習，強度放輕。`
          : `以「${freq.label}」為起點，建議頻率 ${freq.perWeek}。${freq.note}`;
        text +=
          board === 'snowboard'
            ? ' 標著「單板專項」的是加在通用課表之上的抗旋轉動作，練的是「骨盆穩住、上半身獨立轉動」。照這一份排好的做就可以，不用把幾篇文章的課表全部加起來。'
            : ' 標著「雙板專項」的是加在通用課表之上的動作，練的是單腿控制、左右腳之間的重心轉移，以及「上身不動、下身轉」，目的是保護十字韌帶。照這一份排好的做就可以，不用把幾篇文章的課表全部加起來。';
        if (!isShort && totalWeeks < 6) {
          text +=
            ' 因為時間較短，這份計畫已經跳過或壓縮了肌力打底階段，把重點放在進步最快的平衡與落地控制。';
        }
        note.textContent = text;
      }

      const wrap = document.getElementById('plan-weeks');
      if (!wrap) return;
      wrap.textContent = '';

      let weekCursor = 0;
      plan.forEach(({ phase, len }) => {
        if (len <= 0) return;

        const start = new Date(today);
        start.setDate(start.getDate() + weekCursor * 7);
        const end = new Date(today);
        end.setDate(end.getDate() + (weekCursor + len) * 7 - 1);
        weekCursor += len;
        // 短期方案一路做到出發前一天，不是只排整數週
        if (isShort) end.setTime(departure.valueOf() - 86400000);

        const card = document.createElement('div');
        card.className = 'min-w-0 rounded-2xl border border-line bg-surface p-5 sm:p-6';

        const head = document.createElement('div');
        head.className = 'flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1';

        const h3 = document.createElement('h3');
        h3.className = 'text-lg font-black text-head';
        h3.textContent = isShort ? `${phase.name}（${days} 天）` : `${phase.name}（${len} 週）`;

        const range = document.createElement('p');
        range.className = 'text-xs text-muted';
        range.textContent = `${fmt(start)} – ${fmt(end)} · ${isShort ? '每天' : freq.perWeek}`;

        head.append(h3, range);

        const goal = document.createElement('p');
        goal.className = 'mt-2 text-sm break-words text-accent';
        goal.textContent = `目標：${phase.goal}`;

        const ul = document.createElement('ul');
        ul.className = 'mt-4 space-y-2';

        // 專項動作標出來，印出來之後還是看得出哪幾項是板種專項、為什麼會在這裡
        const addItem = (item: string, special = false) => {
          const li = document.createElement('li');
          li.className =
            'flex min-w-0 gap-2.5 rounded-xl border border-line bg-panel px-4 py-2.5 text-sm leading-relaxed break-words text-muted';
          const dot = document.createElement('span');
          dot.className = 'shrink-0 text-accent';
          dot.textContent = '·';
          const span = document.createElement('span');
          span.className = 'min-w-0';
          if (special) {
            const tag = document.createElement('span');
            tag.className =
              'mr-1.5 rounded bg-tint2 px-1.5 py-0.5 text-[10px] font-bold whitespace-nowrap text-head';
            tag.textContent = tagText;
            span.append(tag);
          }
          span.append(document.createTextNode(item));
          li.append(dot, span);
          ul.append(li);
        };

        for (const item of phase.items) addItem(item);
        for (const item of phase[board] ?? []) addItem(item, true);

        card.append(head, goal, ul);
        wrap.append(card);
      });

      // 練夠了的標準。專項是補強，所以通用標準加上自己板種的標準都要達到
      const checksWrap = document.getElementById('plan-checks');
      if (checksWrap) {
        checksWrap.textContent = '';
        const rows: Array<[string, boolean]> = CHECKS.common.map((c) => [c, false] as [string, boolean]);
        for (const c of CHECKS[board]) rows.push([c, true]);
        for (const [text, special] of rows) {
          const li = document.createElement('li');
          li.className =
            'flex min-w-0 gap-2.5 rounded-xl border border-line bg-panel px-4 py-2.5 text-sm leading-relaxed break-words text-muted';
          const mark = document.createElement('span');
          mark.className = 'shrink-0 text-accent';
          mark.textContent = '✓';
          const span = document.createElement('span');
          span.className = 'min-w-0';
          if (special) {
            const tag = document.createElement('span');
            tag.className =
              'mr-1.5 rounded bg-tint2 px-1.5 py-0.5 text-[10px] font-bold whitespace-nowrap text-head';
            tag.textContent = tagText;
            span.append(tag);
          }
          span.append(document.createTextNode(text));
          li.append(mark, span);
          checksWrap.append(li);
        }
      }

      (window as any).snowmedTrack?.('done', 'training-plan');

      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    document.getElementById('plan-print')?.addEventListener('click', () => window.print());
  }
</script>
