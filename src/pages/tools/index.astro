---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { TOOLS, TOOL_CATEGORIES } from '../../consts';
import PopularTools from '../../components/PopularTools.astro';
---

<BaseLayout
  title="滑雪醫學工具箱"
  eyebrow="Tools"
  description="免費、免註冊的滑雪運動醫學工具，分成「行前準備與訓練」和「受傷了才需要看」兩類：雪場選擇、體能檢測、訓練計畫、行前檢核表、台灣室內滑雪場館、受傷分流、何時該照 X 光、腦震盪、回歸雪場評估。"
>
  <section class="bg-panel">
    <div class="mx-auto max-w-6xl px-5 py-12 sm:py-16">
      <p class="max-w-2xl text-base leading-relaxed break-words text-muted">
        每個工具都可以直接使用，不需要註冊、不需要留下任何聯絡方式。<strong class="text-head">你在工具裡填的內容（身高體重、勾選項目、症狀）完全留在你自己的瀏覽器，不會傳送到任何伺服器。</strong>
      </p>

      <div class="mt-8 max-w-xl">
        <PopularTools />
      </div>

      <div class="mt-10 flex flex-wrap gap-2">
        {
          TOOL_CATEGORIES.map((cat) => (
            <a
              href={`#${cat.id}`}
              class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-bold text-head transition-colors hover:border-linestrong"
            >
              <span aria-hidden="true">{cat.emoji}</span> {cat.label}
            </a>
          ))
        }
      </div>

      <div class="mt-10 space-y-14">
        {
          TOOL_CATEGORIES.map((cat) => (
            <div id={cat.id} class="min-w-0 scroll-mt-24">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-line pb-4">
                <h2 class="text-xl font-black break-words text-head sm:text-2xl">
                  <span aria-hidden="true">{cat.emoji}</span> {cat.label}
                </h2>
                <p class="text-sm break-words text-muted">{cat.intro}</p>
              </div>

              <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {TOOLS.filter((t) => t.category === cat.id).map((t) => (
                  <ToolCard {...t} />
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-12 rounded-2xl border border-line bg-surface p-6">
        <h2 class="font-black text-head">想要什麼工具？</h2>
        <p class="mt-2 text-sm leading-relaxed break-words text-muted">
          這個平台會持續增加工具。如果你在準備滑雪或處理傷勢的過程中，遇到某個「如果有個東西能幫我算一下就好了」的時刻，
          歡迎<a href="/wishlist" class="font-bold text-accent hover:underline">告訴我</a>。
        </p>
        <p class="mt-2 text-sm leading-relaxed break-words text-muted">
          或是覺得某個工具哪裡使用起來不順手的話，也可以在<a
            href="/wishlist"
            class="font-bold text-accent hover:underline">許願留言區</a
          >留言回覆喔。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
