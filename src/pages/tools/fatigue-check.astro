---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Faq from '../../components/Faq.astro';
import { SITE_A } from '../../consts';

/**
 * 疲勞指數監測（過度訓練自我檢測）
 *
 * 內容整理自楊醫師演講「訓練時機點怎麼抓」「過度訓練的症狀」「量力而為」那幾張投影片：
 * 一般適應症候群、超補償、過度訓練的九個症狀、靜態心率與 HRV 的自我監控。
 *
 * 判讀規則刻意簡單：勾到三個以上就提醒可能練過頭。
 * 過度訓練沒有單一確診指標，臨床上靠的就是「症狀叢集 + 表現下降 + 監控數值偏離基準」，
 * 所以這裡只做提醒與行動建議，不下診斷。
 */

/** 投影片上的九個症狀。每個附一句「怎麼算數」，避免有人把一般的累也勾下去 */
const SYMPTOMS = [
  { id: 'mood', emoji: '😟', label: '情緒起伏', hint: '比平常容易煩躁、提不起勁，對本來喜歡的事也沒興趣。' },
  { id: 'hr', emoji: '💓', label: '心跳加快', hint: '早上剛醒來的心跳比自己平常快（大約多 5–10 下／分鐘以上）。' },
  { id: 'perf', emoji: '📉', label: '表現下降', hint: '一樣的重量、一樣的雪道，做起來明顯比以前吃力。' },
  { id: 'appetite', emoji: '🍔', label: '沒有胃口', hint: '吃不下、體重下降，或訓練後完全不想吃東西。' },
  { id: 'doms', emoji: '🦵', label: '肌肉痠痛', hint: '痠痛超過 72 小時還沒退，或每次訓練後都痛得比以前久。' },
  { id: 'focus', emoji: '🧠', label: '無法專注', hint: '注意力難集中、反應變慢，動作也跟著變遲鈍。' },
  { id: 'sick', emoji: '🤧', label: '頻頻感冒', hint: '一個月內反覆感冒、喉嚨痛，或小傷口特別慢好。' },
  { id: 'weak', emoji: '🥵', label: '持續無力', hint: '休息一整天也沒有回復的那種疲倦，不是單純的累。' },
  { id: 'sleep', emoji: '😴', label: '失眠', hint: '睡不著、睡不沉，或睡滿八小時醒來還是覺得累。' },
];

const MONITOR = [
  {
    id: 'daily',
    label: '有，每天固定量',
    lead: '很好，你已經有自己的基準值了。',
    tips: [
      '固定同一個時間、同一個姿勢量 —— 最推薦剛睡醒還躺著的時候，起床活動後數字就不能比了。',
      '不要看單一天：用最近 7 天的平均跟你自己的基準比。單日偏高可能只是前一晚喝了酒或睡不好。',
      '靜態心率比基準高 5–10 下／分鐘、或 HRV 明顯低於基準並連續兩三天，就把當天的訓練降強度或改成休息。',
      '出發滑雪前一週開始減量（Tapering），把體力留到雪場再用。',
    ],
  },
  {
    id: 'sometimes',
    label: '有手錶，但沒固定量',
    lead: '手錶已經在記了，差的只是「固定」這件事。',
    tips: [
      '睡覺時也戴著，讓手錶自動記錄整夜的靜態心率與 HRV —— 這是最省事、也最穩定的做法。',
      '先連續兩週不改變訓練，讓手錶算出屬於你的基準值。沒有基準值，再漂亮的數字都讀不出意義。',
      '每天早上花十秒看一眼就好：今天的數字跟基準差多少，比數字本身重要。',
      '手錶的「身體電量」「Body Battery」「恢復指數」這類綜合分數可以當參考，但真正要看的還是心率與 HRV 的趨勢。',
    ],
  },
  {
    id: 'none',
    label: '沒有在監測',
    lead: '不用買手錶也能開始，一根手指就夠了。',
    tips: [
      '每天早上剛睡醒、還躺在床上的時候，摸手腕或頸動脈數 60 秒的脈搏，記在手機裡。',
      '連續記兩週，算出平均，那就是你的基準值。',
      '之後只要哪天比基準高 5–10 下／分鐘，而且不是因為前一晚熬夜或喝酒，就把當天的強度降下來。',
      '想更省事再考慮運動手錶；重點從來不是裝備，是每天同一個時間量、並且跟自己比。',
    ],
  },
];

const FAQ = [
  {
    q: '怎麼分辨只是「累」還是「過度訓練」？',
    a: '關鍵是時間與回復。一般的疲勞睡一晚、休息一到兩天就會好；過度訓練是休息了還是累，而且會同時出現一整叢的訊號 —— 表現下降、睡不好、心跳變快、容易生病、情緒變差。單一症狀不用緊張，三個以上同時出現才值得認真看待。',
  },
  {
    q: '訓練後要休息多久才會變強？',
    a: '身體在訓練後的適應（超補償）大約在 36–72 小時之間出現。也就是說，真正讓你變強的是那段休息，而不是訓練當下。在超補償還沒發生就又上一次大重量，累積的只有疲勞。',
  },
  {
    q: '出發滑雪前兩週才開始猛練，有用嗎？',
    a: '幫助有限，風險反而高。臨時「趕進度」式的訓練會讓肌肉疲勞累積、肌腱發炎的風險大增，而且適應根本來不及發生。比較好的做法是提早開始漸進式訓練，並在出發前一週降低強度（Tapering），把體力留給雪場。',
  },
  {
    q: '靜態心率跟 HRV 要怎麼看？數字多少才正常？',
    a: '沒有一個對所有人都適用的「正常值」，這兩個指標只有跟你自己的基準比才有意義。靜態心率比自己的平常值高 5–10 下／分鐘，或 HRV 明顯低於自己的基準且持續幾天，通常代表身體還在應付壓力、還沒回復。HRV 反映的是自律神經的狀態：偏低代表交感神經（戰鬥、逃跑）比較活躍，通常伴隨較高的壓力水平。',
  },
  {
    q: '為什麼滑雪一天裡會有兩個受傷高峰？',
    a: '研究雪場營業時間內的受傷分布，受傷件數從早上開始上升，大約 11 點到達第一個高峰，中午過後下降，下午 3 點左右又出現第二個高峰。第二個高峰推測與體力下滑有關。實務上的意思很簡單：下午覺得腿軟的時候，那一趟就是最該放掉的一趟。',
  },
  {
    q: '這些症狀會不會其實是別的病？',
    a: '會，而且很重要。持續疲倦、心跳變快、體重下降、反覆感染也可能是貧血、甲狀腺疾病、感染或情緒疾患。如果你已經降低訓練量、好好睡了兩週還是沒有改善，或出現發燒、明顯體重減輕、胸痛、呼吸困難，請就醫檢查，不要當成單純的練過頭。',
  },
];
---

<ToolLayout
  title="疲勞指數監測"
  seoTitle="是不是練過頭了？過度訓練九個症狀自我檢測，附靜態心率與 HRV 監控方法"
  emoji="🔋"
  time="約 2 分鐘"
  summary="受傷不一定是技術問題，很多時候是身體已經沒電了。勾選你最近一週出現的狀況，超過三個就代表可能練過頭；下面再依你有沒有在量靜態心率或 HRV，給你一套每天十秒就能做完的自我監控方式。"
  description="滑雪與重訓的過度訓練自我檢測：勾選情緒起伏、心跳加快、表現下降等九個過度訓練症狀，三個以上代表可能練過頭，並提供靜態心率與心率變異（HRV）的每日監控與減量建議。"
>
  <div class="rounded-2xl border-l-4 border-accent bg-tint1 p-5">
    <p class="text-sm leading-relaxed break-words text-body">
      <strong class="text-head">身體面對訓練壓力的反應是固定的：先變弱、再變強、練過頭又變弱。</strong>
      中間那段「變強」就是最適合訓練的時候；錯過它繼續加量，就會滑進過度訓練。
      這個工具不會告訴你該練多少，它要做的是讓你看見自己現在在哪一段。
    </p>
  </div>

  <!-- 症狀勾選 -->
  <section class="mt-8">
    <h2 class="text-lg font-black break-words text-head sm:text-xl">
      一、最近一週，你出現過哪些狀況？
    </h2>
    <p class="mt-2 text-sm leading-relaxed break-words text-muted">
      可以複選。<strong class="text-head">請以「跟你自己平常比」為準</strong
      >，不是跟別人比。想不起來的就不要勾。
    </p>

    <div id="symptoms" class="mt-5 grid gap-3 sm:grid-cols-2">
      {
        SYMPTOMS.map((s) => (
          <label class="group min-w-0 cursor-pointer rounded-2xl border border-line bg-surface p-4 transition-colors hover:border-linestrong has-[:checked]:border-accent has-[:checked]:bg-tint1">
            <div class="flex items-start gap-3">
              <input type="checkbox" class="sr-only" data-symptom={s.id} />
              <span
                class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg border border-linestrong text-sm leading-none group-has-[:checked]:border-accent group-has-[:checked]:bg-accent group-has-[:checked]:text-bg"
                aria-hidden="true"
              >
                <span class="hidden group-has-[:checked]:inline">✓</span>
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold break-words text-head">
                  <span aria-hidden="true">{s.emoji}</span> {s.label}
                </span>
                <span class="mt-1 block text-xs leading-relaxed break-words text-muted">
                  {s.hint}
                </span>
              </span>
            </div>
          </label>
        ))
      }
    </div>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-line bg-surface px-5 py-4">
      <p class="text-sm font-bold text-head">
        已勾選 <span id="symptom-count" class="text-accent tabular-nums">0</span> / {SYMPTOMS.length} 項
      </p>
      <button
        type="button"
        id="symptom-reset"
        class="rounded-xl border border-line px-4 py-2 text-xs font-bold text-head transition-colors hover:bg-tint1"
      >
        全部清空
      </button>
    </div>

    <div id="symptom-result" class="mt-5 rounded-2xl border-l-4 p-5" hidden>
      <p class="flex items-center gap-2 text-base font-black break-words">
        <span id="result-emoji" class="text-2xl leading-none" aria-hidden="true"></span>
        <span id="result-title" class="min-w-0"></span>
      </p>
      <p id="result-body" class="mt-2.5 text-sm leading-relaxed break-words text-body"></p>
      <ul id="result-actions" class="mt-3 space-y-1.5 text-sm leading-relaxed break-words text-body"></ul>
    </div>
  </section>

  <!-- 監控習慣 -->
  <section class="mt-12 border-t border-line pt-10">
    <h2 class="text-lg font-black break-words text-head sm:text-xl">
      二、你有沒有在固定監測靜態心率或 HRV？
    </h2>
    <p class="mt-2 text-sm leading-relaxed break-words text-muted">
      症狀是主觀的，數字可以幫你早幾天發現。<strong class="text-head"
        >靜態心率</strong
      >（睡醒還躺著時的心跳）代表昨晚有沒有回復；<strong class="text-head">HRV（心率變異）</strong
      >代表自律神經穩不穩定 —— 偏低通常是交感神經還在戰鬥狀態，也就是壓力還沒退。
    </p>

    <div id="monitor" class="mt-5 grid gap-2 sm:grid-cols-3">
      {
        MONITOR.map((m) => (
          <button
            type="button"
            data-monitor={m.id}
            class="monitor-btn min-w-0 rounded-xl border border-line bg-surface px-4 py-3 text-sm font-bold break-words text-head transition-colors hover:border-accent hover:bg-tint1"
            aria-pressed="false"
          >
            {m.label}
          </button>
        ))
      }
    </div>

    {
      MONITOR.map((m) => (
        <div
          data-monitor-tips={m.id}
          class="mt-5 rounded-2xl border border-accent/60 bg-surface p-5 sm:p-6"
          hidden
        >
          <p class="text-sm font-black break-words text-head">{m.lead}</p>
          <ul class="mt-3 space-y-2">
            {m.tips.map((t) => (
              <li class="flex min-w-0 items-start gap-2.5 text-sm leading-relaxed break-words text-body">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span class="min-w-0">{t}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 border-t border-line pt-3 text-xs leading-relaxed break-words text-muted">
            <strong class="text-head">前提：</strong>
            這兩個數字都只能跟「你自己的基準」比，不能跟別人比，也不能只看一天。沒有基準值之前，先累積兩週的資料再說。
          </p>
        </div>
      ))
    }
  </section>

  <!-- 雪場當天 -->
  <section class="mt-12 border-t border-line pt-10">
    <h2 class="text-lg font-black break-words text-head sm:text-xl">在雪場那幾天怎麼用</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="min-w-0 rounded-2xl border border-line bg-surface p-5">
        <h3 class="font-black break-words text-head">出發前一週要減量</h3>
        <p class="mt-2 text-sm leading-relaxed break-words text-muted">
          很多人是出發前兩週才開始猛練，結果把疲勞帶上山。訓練後的適應要
          <strong class="text-head">36–72 小時</strong>才會出現，臨時抱佛腳來不及，只會累積疲勞與肌腱發炎的風險。出發前一週應該降低強度（Tapering），把體力留到雪場。
        </p>
      </div>
      <div class="min-w-0 rounded-2xl border border-line bg-surface p-5">
        <h3 class="font-black break-words text-head">下午三點那一趟，最該放掉</h3>
        <p class="mt-2 text-sm leading-relaxed break-words text-muted">
          雪場一天的受傷件數有兩個高峰：上午
          <strong class="text-head">11 點</strong>前後一個，下午
          <strong class="text-head">3 點</strong>前後又一個。第二個高峰推測與體力下滑有關。累了就收，纜車明天還在。
        </p>
      </div>
    </div>
  </section>

  <Fragment slot="basis">
    <p>
      <strong>一般適應症候群（General Adaptation Syndrome，Selye）</strong
      >：身體面對任何壓力都會走過三個階段 —— 警報期（表現先掉下去）、對抗期（適應、變強）、耗竭期（撐不住，表現再度下滑）。
      <strong>對抗期就是最適合訓練的時候</strong>，過猶不及講的就是硬撐到耗竭期那一段。
    </p>
    <p>
      <strong>超補償（Supercompensation）</strong
      >：訓練造成疲勞、表現暫時下降，休息之後身體會回補到比原來更高的水準，這個適應大約在訓練後
      <strong>36–72 小時</strong>出現。練得剛好，是在超補償出現時給下一次刺激；練太多，是在還沒回補時又壓下去，於是表現一路往下。
    </p>
    <p>
      <strong>過度訓練症候群（Overtraining）</strong
      >：在不對的時間持續訓練的結果。它沒有單一的確診指標，臨床上看的是一整叢訊號同時出現
      —— 本頁列的九個症狀就是最常被提到的那些。這個工具用「三個以上」當提醒門檻，是為了讓你有個具體的界線，不是診斷標準。
    </p>
    <p>
      <strong>靜態心率與心率變異（HRV）</strong
      >：靜態心率反映休息回復的狀況，HRV 反映自律神經系統的穩定程度（偏高＝副交感神經主導，休息與修復；偏低＝交感神經主導，戰鬥或逃跑），通常高
      HRV 對應較低的壓力水平。兩者都<strong>必須有個人基準值</strong
      >、而且要長時間觀察才有意義，所以建議睡覺時也戴著手錶，或每天在同一時間徒手測量。
    </p>
    <p>
      <strong>雪場一天內的受傷分布</strong>：受傷件數自早上逐步上升，11
      點前後出現第一個高峰，午後下降，下午 3 點前後再出現第二個高峰，推測與體力下滑有關（Xiao Ma
      2023；Dickson, T. J., &amp; Terwiel, F. A., 2020）。
    </p>
    <p>
      內容整理自楊醫師的滑雪運動醫學演講。更完整的行前訓練規劃可以搭配
      <a href="/tools/training-plan">行前肌力＆體能訓練計畫產生器</a>與<a href="/tools/fitness-check"
        >行前體能自我檢測</a
      >，衛教專文在<a href={SITE_A.articlesUrl} target="_blank" rel="noopener noreferrer"
        >楊醫師的個人網站</a
      >。
    </p>
  </Fragment>

  <Fragment slot="limits">
    <ul>
      <li>
        <strong>這不是診斷。</strong
        >過度訓練沒有單一檢查可以確認，勾很多項只代表「值得認真看待」，不代表你一定有過度訓練症候群；勾很少也不保證身體就沒事。
      </li>
      <li>
        <strong>這些症狀都不是過度訓練專屬的。</strong
        >持續疲倦、心跳變快、體重下降、反覆感染也可能是貧血、甲狀腺疾病、感染或情緒疾患。降低訓練量、好好睡兩週還是沒改善，就該就醫。
      </li>
      <li>
        <strong>出現這些狀況請直接就醫，不要在這裡找答案：</strong
        >發燒不退、明顯的體重減輕、胸痛、運動時呼吸困難或頭暈到快昏倒、休息時心跳持續異常快。
      </li>
      <li>
        <strong>心率與 HRV 的數字不能跨人比較。</strong
        >別人的數字對你沒有參考價值，甚至你自己在生病、時差、飲酒、經期或高海拔時的數字也不能拿來跟平常比。
      </li>
      <li>
        <strong>已經受傷的話，這個工具幫不上忙。</strong
        >疼痛、腫脹或關節不穩請用<a href="/tools/injury-triage">雪場受傷分流判斷</a>或直接就醫。
      </li>
    </ul>
  </Fragment>

  <Fragment slot="faq">
    <Faq items={FAQ} />
  </Fragment>
</ToolLayout>

<script>
  const box = document.getElementById('symptoms');
  const countEl = document.getElementById('symptom-count');
  const resetBtn = document.getElementById('symptom-reset');
  const result = document.getElementById('symptom-result');
  const emojiEl = document.getElementById('result-emoji');
  const titleEl = document.getElementById('result-title');
  const bodyEl = document.getElementById('result-body');
  const actionsEl = document.getElementById('result-actions');

  /**
   * 分級。門檻訂在三個 ——
   * 一兩個症狀每個人都有，三個以上同時出現才是「叢集」，值得當一回事。
   */
  const TIERS = [
    {
      min: 6,
      key: 'high',
      emoji: '🔴',
      border: 'border-red-500',
      bg: 'bg-red-500/10',
      title: '訊號很多，身體已經在抗議了',
      body: '這個數量的症狀同時出現，代表疲勞累積得相當明顯。繼續照原訂的量練下去，變強的機會很低，受傷與生病的機會倒是會一直升高。',
      actions: [
        '這一週先把訓練量砍一半以上，或直接安排幾天完全休息 —— 休息也是訓練的一部分。',
        '先把睡眠補回來：睡眠不足的時候，其他做什麼都補不回來。',
        '如果減量、補眠兩週後還是沒有改善，或有發燒、體重明顯下降、胸痛，請就醫檢查。',
        '如果滑雪行程就在最近，出發前這一週不要再加練了，把體力留到雪場。',
      ],
    },
    {
      min: 3,
      key: 'mid',
      emoji: '🟠',
      border: 'border-amber-500',
      bg: 'bg-amber-500/10',
      title: '符合過度訓練的樣子，該減量了',
      body: '三個以上的訊號同時出現，通常代表訓練量已經超過目前的回復能力。這不是意志力的問題 —— 適應是在休息時發生的，沒有休息就沒有進步。',
      actions: [
        '接下來一週把強度或訓練量降下來（先降強度，再降次數），給身體 36–72 小時完整回復。',
        '開始每天固定量靜態心率：連續幾天偏高，就是身體還沒回來的客觀證據。',
        '睡眠、蛋白質與熱量先顧好，這三個沒到位，練再多也只是在挖洞。',
        '要出發滑雪的話，出發前一週開始減量（Tapering）。',
      ],
    },
    {
      min: 1,
      key: 'low',
      emoji: '🟡',
      border: 'border-amber-400',
      bg: 'bg-amber-400/10',
      title: '有一點累積，還在可以處理的範圍',
      body: '一兩個訊號很常見，不一定是過度訓練，但它是身體給的第一個提示。接下來幾天注意它有沒有變多或變久。',
      actions: [
        '這幾天先不要再加量，維持現狀就好，讓身體把這一波吃下去。',
        '睡飽一點，特別是有失眠或早上心跳偏快的話。',
        '過幾天再回來勾一次：症狀變少就沒事，變多就照上一級處理。',
      ],
    },
    {
      min: 0,
      key: 'none',
      emoji: '🟢',
      border: 'border-emerald-500',
      bg: 'bg-emerald-500/10',
      title: '目前沒有明顯的過度訓練訊號',
      body: '看起來回復得不錯。這是加量的好時機 —— 但記得加的是「一點點」，而且加完要留 36–72 小時讓身體適應。',
      actions: [
        '維持現在的節奏，每次增加的量不要一次跳太多。',
        '趁沒事的時候把基準值建立起來：每天同一時間量靜態心率，連續兩週。',
        '出發滑雪前一週記得減量，把狀態帶到雪場而不是留在健身房。',
      ],
    },
  ];

  if (box && countEl && result && emojiEl && titleEl && bodyEl && actionsEl) {
    const boxes = Array.from(box.querySelectorAll<HTMLInputElement>('[data-symptom]'));

    const render = () => {
      const picked = boxes.filter((b) => b.checked);
      countEl.textContent = String(picked.length);

      const tier = TIERS.find((t) => picked.length >= t.min)!;
      result.className = `mt-5 rounded-2xl border-l-4 p-5 ${tier.border} ${tier.bg}`;
      emojiEl.textContent = tier.emoji;
      titleEl.textContent = tier.title;
      bodyEl.textContent = tier.body;

      actionsEl.textContent = '';
      for (const a of tier.actions) {
        const li = document.createElement('li');
        li.className = 'flex min-w-0 items-start gap-2.5';
        const dot = document.createElement('span');
        dot.className = 'mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent';
        dot.setAttribute('aria-hidden', 'true');
        const span = document.createElement('span');
        span.className = 'min-w-0';
        span.textContent = a;
        li.append(dot, span);
        actionsEl.append(li);
      }

      result.hidden = false;
      return tier.key;
    };

    let tracked = false;
    for (const b of boxes) {
      b.addEventListener('change', () => {
        const key = render();
        if (!tracked) {
          (window as any).snowmedTrack?.('done', 'fatigue-check');
          tracked = true;
        }
        (window as any).snowmedTrack?.('result', `fatigue-check/${key}`);
      });
    }

    resetBtn?.addEventListener('click', () => {
      for (const b of boxes) b.checked = false;
      countEl.textContent = '0';
      result.hidden = true;
    });
  }

  // 監控習慣：選一個，顯示對應的做法
  const monitorBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.monitor-btn'));
  const tipBoxes = Array.from(document.querySelectorAll<HTMLElement>('[data-monitor-tips]'));

  for (const btn of monitorBtns) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.monitor;
      for (const b of monitorBtns) {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('border-accent', on);
        b.classList.toggle('bg-tint1', on);
      }
      for (const t of tipBoxes) t.hidden = t.dataset.monitorTips !== id;
      (window as any).snowmedTrack?.('result', `fatigue-check/monitor/${id}`);
    });
  }
</script>
