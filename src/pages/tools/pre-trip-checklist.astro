---
import ToolLayout from '../../layouts/ToolLayout.astro';
import Faq from '../../components/Faq.astro';
import { CHECKLIST, PHASES } from '../../data/checklist';

const filters = [
  {
    name: 'board',
    label: '你玩的是？',
    options: [
      { v: 'ski', label: '雙板 Ski' },
      { v: 'snowboard', label: '單板 Snowboard' },
    ],
  },
  {
    name: 'level',
    label: '目前程度？',
    options: [
      { v: 'beginner', label: '新手（綠線為主）' },
      { v: 'intermediate', label: '中階（能滑紅線）' },
      { v: 'advanced', label: '進階（黑線、公園、樹林）' },
    ],
  },
  {
    name: 'injury',
    label: '有沒有舊傷？',
    options: [
      { v: 'none', label: '沒有' },
      { v: 'knee', label: '膝蓋' },
      { v: 'shoulder', label: '肩膀' },
      { v: 'back', label: '腰背' },
      { v: 'other', label: '其他部位' },
    ],
  },
];
// 常見問題：問句就是大家實際會搜的字
const FAQ = [
  {
    q: '第一次去滑雪，哪些東西要自己帶、哪些可以租？',
    a: '雪鏡、防水手套、防曬、護唇膏、排汗底層這些貼身或雪場租不到的東西要自己帶；雪衣雪褲、安全帽、雪板雪鞋在雪場都租得到。',
  },
  {
    q: '完全沒學過滑雪，需要請教練嗎？',
    a: '需要，而且要在出發前就預約好。旺季雪校的中文教練常常提前額滿，到了現場才找很可能沒有。',
  },
  {
    q: '滑雪保險要注意什麼？',
    a: '出發前確認三件事：保單有沒有把滑雪列為除外項目、海外醫療的理賠上限、有沒有包含搜救費用。清單只能提醒你要確認的項目，實際涵蓋範圍請直接問保險公司。',
  },
  {
    q: '到了雪場第一件事該做什麼？',
    a: '看懂雪場地圖、找到巡邏隊（patrol）的位置與電話、確認最近的醫療院所在哪裡，並把緊急電話存進手機。很多人跳過這一段，然後在雪道上才發現不對。',
  },
  {
    q: '滑行期間什麼時候該下山？',
    a: '天氣轉壞、開始暴風雪就趕快下山；很多纜車會依雪況提早關閉，要隨時注意公告。另外絕對不要自己進野雪區——雪崩、樹井都是致命風險，而且會讓救難人員跟著冒險。',
  },
];
---

<ToolLayout
  title="出發前注意事項互動檢核表"
  seoTitle="滑雪新手行前準備清單：出發前、抵達雪場、滑行期間的注意事項"
  emoji="✅"
  time="約 3 分鐘 · 勾選狀態會自動保存"
  summary="選擇你的板種、程度和舊傷狀況，產生一份專屬於你的清單，分成「在台灣出發前」「抵達雪場、滑行前」「滑行期間」三個階段。每一項都寫了「為什麼」，你可以自己決定要不要採納。勾選狀態存在你的瀏覽器裡，關掉再回來還在。"
  description="滑雪行前檢核表：分成在台灣出發前、抵達雪場滑行前、滑行期間三階段，依單板／雙板、新手／老手、有無舊傷動態產生個人化清單，可列印或存成 PDF。"
>
  <!-- 篩選 -->
  <form id="cl-filters" class="space-y-5 print:hidden">
    {
      filters.map((f) => (
        <fieldset class="min-w-0 rounded-2xl border border-line bg-surface p-5">
          <legend class="px-2 text-sm font-bold text-head">{f.label}</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {f.options.map((o, i) => (
              <label class="min-w-0 cursor-pointer rounded-xl border border-line bg-panel px-4 py-2.5 text-sm text-body transition-colors hover:border-linestrong has-[:checked]:border-cta has-[:checked]:bg-cta has-[:checked]:font-bold has-[:checked]:text-ctatext">
                <input
                  type="radio"
                  name={f.name}
                  value={o.v}
                  checked={i === 0}
                  class="sr-only"
                />
                <span class="break-words">{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
  </form>

  <!-- 進度 -->
  <div
    id="cl-progress"
    class="on-dark mt-8 rounded-2xl border border-line bg-band p-5 text-white sm:p-6"
  >
    <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
      <p class="text-sm font-bold">你的清單完成度</p>
      <p class="tabular-nums" aria-live="polite">
        <span id="cl-pct" data-bump class="inline-block text-4xl font-black text-accent">0%</span>
        <span class="ml-2 text-sm text-muted">
          <span id="cl-done">0</span> / <span id="cl-total">0</span> 項
        </span>
      </p>
    </div>
    <div
      id="cl-track"
      class="mt-3 h-2.5 w-full overflow-hidden rounded-full bg-tint3"
      role="progressbar"
      aria-label="清單完成度"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <div
        id="cl-bar"
        class="h-full rounded-full bg-accent transition-all duration-500"
        style="width:0%"
      >
      </div>
    </div>
    <p id="cl-critical" class="mt-3 text-xs text-body/85"></p>
  </div>

  <div class="mt-5 flex flex-wrap gap-3 print:hidden">
    <button
      type="button"
      id="cl-print"
      class="rounded-xl bg-cta px-5 py-3 text-sm font-bold text-ctatext hover:bg-accent">列印 / 存成 PDF</button
    >
    <button
      type="button"
      id="cl-clear"
      class="rounded-xl border border-line bg-panel px-5 py-3 text-sm font-bold text-head hover:bg-tint1"
      >清除所有勾選</button
    >
  </div>

  <!--
    跟著畫面走的進度條：往下捲、上面的完成度看不到時才出現，
    捲完清單就收起來。只是視覺提示（上面那塊已經會用 aria-live 念出來），
    而且不攔截點擊，不會擋到下面的勾選框。
  -->
  <div
    id="cl-float"
    class="on-dark pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition-all duration-300 print:hidden"
    aria-hidden="true"
  >
    <div class="mx-auto max-w-3xl px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
      <div
        class="rounded-2xl border border-line bg-band/95 px-4 py-3 shadow-2xl shadow-black/40 backdrop-blur"
      >
        <div class="flex items-center gap-3">
          <span
            id="cl-float-pct"
            data-bump
            class="inline-block w-16 shrink-0 text-2xl font-black text-accent tabular-nums"
            >0%</span
          >
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2 text-xs">
              <span id="cl-float-msg" class="truncate font-bold text-head"></span>
              <span class="shrink-0 text-body tabular-nums">
                <span id="cl-float-done">0</span> / <span id="cl-float-total">0</span> 項
              </span>
            </div>
            <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-tint3">
              <div
                id="cl-float-bar"
                class="h-full rounded-full bg-accent transition-all duration-500"
                style="width:0%"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 清單 -->
  <div id="cl-list" class="mt-10 space-y-12">
    {
      PHASES.map((phase) => (
        <div data-phase={phase.id} class="min-w-0">
          <div class="rounded-2xl border border-line bg-band px-5 py-4 text-white on-dark sm:px-6">
            <div class="flex items-baseline gap-2.5">
              <span class="text-xl leading-none" aria-hidden="true">
                {phase.emoji}
              </span>
              <h2 class="text-lg font-black break-words text-head sm:text-xl">{phase.title}</h2>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed break-words text-body/85">{phase.subtitle}</p>
          </div>

          <div class="mt-5 space-y-6">
            {CHECKLIST.filter((s) => s.phase === phase.id).map((section) => (
        <section data-section={section.id} class="min-w-0">
          <div class="flex items-baseline gap-2.5">
            <span class="text-xl leading-none" aria-hidden="true">
              {section.emoji}
            </span>
            <h3 class="text-base font-black break-words text-head sm:text-lg">{section.title}</h3>
          </div>
          <p class="mt-1.5 text-sm break-words text-muted">{section.intro}</p>

          <ul class="mt-4 space-y-2.5">
            {section.items.map((item) => (
              <li
                data-item
                data-boards={(item.boards ?? []).join(',')}
                data-levels={(item.levels ?? []).join(',')}
                data-injuries={(item.injuries ?? []).join(',')}
                class="min-w-0 overflow-hidden rounded-xl border border-line bg-panel"
              >
                <label class="flex min-w-0 cursor-pointer items-start gap-3 p-4">
                  <input
                    type="checkbox"
                    data-check
                    value={item.id}
                    class="mt-1 h-4.5 w-4.5 shrink-0 accent-[var(--color-accent)]"
                  />
                  <span class="min-w-0">
                    <span class="block text-sm leading-relaxed font-medium break-words text-head">
                      {item.label}
                      {item.critical && (
                        <span class="ml-2 rounded-full bg-tint2 px-2 py-0.5 align-middle text-[10px] font-bold whitespace-nowrap text-head">
                          重點
                        </span>
                      )}
                    </span>
                    {item.why && (
                      <span class="mt-1.5 block text-xs leading-relaxed break-words text-muted">
                        {item.why}
                      </span>
                    )}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </section>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- 留一段空白，捲到最後一項時不會被底部進度條蓋住 -->
  <div class="h-24 print:hidden" aria-hidden="true"></div>

  <Fragment slot="basis">
    <p>
      清單的五個分區，對應的是滑雪傷害真正能被介入的五個環節：<strong>防護裝備</strong>、<strong
        >雪具設定</strong
      >、<strong>身體準備</strong>、<strong>保險與文件</strong>、<strong>雪場上的行為</strong>。
    </p>
    <p>
      個人化的邏輯來自雪地運動流行病學上一個很穩定的觀察：<strong
        >單板與雙板的受傷部位分布明顯不同</strong
      >。雙板的典型是膝關節（前十字韌帶、內側副韌帶）與滑雪者拇指；單板則集中在上肢，尤其是向後跌倒撐地造成的手腕骨折。所以護腕對單板初學者是重點項目，對雙板則不是；固定器 DIN 值對雙板是關鍵，對單板則換成高背角度。
    </p>
    <p>
      程度與舊傷的篩選，處理的是風險暴露的差異：初學者跌倒頻率高但速度低，進階者相反；有舊傷的人則需要額外的回歸判斷與護具考量。
    </p>
    <p>每一項都附上「為什麼」，是刻意的設計 —— 你應該要能自己判斷這一條對你合不合理，而不是因為清單上有就照做。</p>
  </Fragment>

  <Fragment slot="limits">
    <ul>
      <li>
        <strong>這是通用清單，不是個別化的醫療建議。</strong>
        它不知道你的具體傷勢、手術方式或目前的復健進度。有舊傷的人，最終仍應以你的主治醫師或治療師的判斷為準。
      </li>
      <li>
        <strong>保險條款每家不同、每年也會改。</strong>
        清單只能提醒你「要去確認哪些項目」，不能代替你閱讀自己的保單。實際的涵蓋範圍請直接向保險公司確認。
      </li>
      <li>
        <strong>固定器 DIN 值請一定要由技師設定。</strong>
        這個數值牽涉到體重、身高、鞋底長度、年齡與滑行型態，網路上的計算表無法取代現場的檢查與釋放測試。
      </li>
      <li>
        <strong>清單勾完不代表安全。</strong>
        它處理的是「可以事先準備的部分」。當天的雪況、天氣、同行者的判斷，以及你自己的決定，影響同樣大。
      </li>
      <li>
        <strong>勾選狀態只存在你這台裝置的瀏覽器裡。</strong>
        換手機、換瀏覽器或清除瀏覽資料就會消失，請以列印或 PDF 的版本為準。
      </li>
    </ul>
  </Fragment>
  <Fragment slot="faq">
    <Faq items={FAQ} />
  </Fragment>
</ToolLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .cl-bump {
      animation: cl-bump 0.35s ease-out;
    }
  }
  @keyframes cl-bump {
    40% {
      transform: scale(1.22);
    }
  }

  @media print {
    :global(header),
    :global(footer) {
      display: none !important;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'snowmed:pretrip-checklist';
  const FILTER_KEY = 'snowmed:pretrip-filters';

  const filtersForm = document.getElementById('cl-filters') as HTMLFormElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-check]'));

  if (filtersForm && items.length) {
    const read = <T,>(key: string, fallback: T): T => {
      try {
        const raw = localStorage.getItem(key);
        return raw ? (JSON.parse(raw) as T) : fallback;
      } catch {
        return fallback;
      }
    };
    const write = (key: string, value: unknown) => {
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch {
        /* 無痕模式或停用儲存空間時忽略 */
      }
    };

    /** 空字串代表「不限制」，否則要包含目前選到的值 */
    const matches = (attr: string, value: string) => {
      if (!attr) return true;
      return attr.split(',').filter(Boolean).includes(value);
    };

    const applyFilters = () => {
      const data = new FormData(filtersForm);
      const board = String(data.get('board') ?? 'ski');
      const level = String(data.get('level') ?? 'beginner');
      const injury = String(data.get('injury') ?? 'none');

      write(FILTER_KEY, { board, level, injury });

      for (const el of items) {
        const ok =
          matches(el.dataset.boards ?? '', board) &&
          matches(el.dataset.levels ?? '', level) &&
          matches(el.dataset.injuries ?? '', injury);
        el.hidden = !ok;
      }

      // 整個區塊都被篩掉的話，把標題也收起來
      for (const section of document.querySelectorAll<HTMLElement>('[data-section]')) {
        const visible = section.querySelectorAll<HTMLElement>('[data-item]:not([hidden])');
        section.hidden = visible.length === 0;
      }

      // 整個階段都空了，連階段標題一起收起來
      for (const phase of document.querySelectorAll<HTMLElement>('[data-phase]')) {
        const visible = phase.querySelectorAll<HTMLElement>('[data-section]:not([hidden])');
        phase.hidden = visible.length === 0;
      }

      updateProgress();
    };

    let lastPct = -1;

    /** 依進度給一句短短的鼓勵，讓人知道自己有在前進 */
    const progressMessage = (pct: number) =>
      pct === 0
        ? '勾一項，就前進一點'
        : pct < 25
          ? '起步了，繼續加油'
          : pct < 50
            ? '持續前進中'
            : pct < 75
              ? '已經過一半了'
              : pct < 100
                ? '快完成了'
                : '全部完成 🎉';

    const updateProgress = () => {
      const visibleBoxes = boxes.filter((b) => !b.closest('[data-item]')?.hidden);
      const done = visibleBoxes.filter((b) => b.checked).length;
      const total = visibleBoxes.length;
      const pct = total ? Math.round((done / total) * 100) : 0;

      const set = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      set('cl-done', String(done));
      set('cl-total', String(total));
      set('cl-pct', `${pct}%`);
      set('cl-float-done', String(done));
      set('cl-float-total', String(total));
      set('cl-float-pct', `${pct}%`);
      set('cl-float-msg', progressMessage(pct));

      for (const id of ['cl-bar', 'cl-float-bar']) {
        const bar = document.getElementById(id);
        if (bar) bar.style.width = pct + '%';
      }
      document.getElementById('cl-track')?.setAttribute('aria-valuenow', String(pct));

      // 數字往上跳的時候輕輕放大一下（第一次載入不跳）
      if (lastPct >= 0 && pct > lastPct) {
        for (const el of document.querySelectorAll<HTMLElement>('[data-bump]')) {
          el.classList.remove('cl-bump');
          void el.offsetWidth;
          el.classList.add('cl-bump');
        }
      }
      lastPct = pct;

      const criticalBoxes = visibleBoxes.filter((b) =>
        b.closest('[data-item]')?.textContent?.includes('重點')
      );
      const criticalLeft = criticalBoxes.filter((b) => !b.checked).length;
      const note = document.getElementById('cl-critical');
      if (note) {
        note.textContent = criticalLeft
          ? `還有 ${criticalLeft} 個「重點」項目沒完成 —— 這些是出發前最不該漏掉的。`
          : total === done && total > 0
            ? '全部完成了，祝你有個安全又盡興的雪季。'
            : '重點項目都完成了，剩下的是加分項。';
      }
    };

    // 還原上次的選擇與勾選狀態
    const savedFilters = read<{ board?: string; level?: string; injury?: string }>(FILTER_KEY, {});
    for (const [name, value] of Object.entries(savedFilters)) {
      if (!value) continue;
      const input = filtersForm.querySelector<HTMLInputElement>(
        `input[name="${name}"][value="${value}"]`
      );
      if (input) input.checked = true;
    }

    const savedChecks = read<string[]>(STORAGE_KEY, []);
    for (const b of boxes) {
      if (savedChecks.includes(b.value)) b.checked = true;
    }

    filtersForm.addEventListener('change', applyFilters);

    for (const b of boxes) {
      b.addEventListener('change', () => {
        write(
          STORAGE_KEY,
          boxes.filter((x) => x.checked).map((x) => x.value)
        );
        updateProgress();
      });
    }

    document.getElementById('cl-print')?.addEventListener('click', () => window.print());

    document.getElementById('cl-clear')?.addEventListener('click', () => {
      for (const b of boxes) b.checked = false;
      write(STORAGE_KEY, []);
      updateProgress();
    });

    applyFilters();

    // 底部進度條：上面的完成度捲出畫面、而且清單還在畫面上時才顯示
    const floatBar = document.getElementById('cl-float');
    const progressCard = document.getElementById('cl-progress');
    const list = document.getElementById('cl-list');
    if (floatBar && progressCard && list && 'IntersectionObserver' in window) {
      let cardVisible = true;
      let listVisible = false;
      const sync = () => {
        const show = !cardVisible && listVisible;
        floatBar.classList.toggle('translate-y-full', !show);
        floatBar.classList.toggle('opacity-0', !show);
      };
      new IntersectionObserver(([e]) => {
        cardVisible = e.isIntersecting;
        sync();
      }).observe(progressCard);
      new IntersectionObserver(([e]) => {
        listVisible = e.isIntersecting;
        sync();
      }).observe(list);
    }
  }
</script>
