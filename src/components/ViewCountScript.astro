<script>
  // 瀏覽計數器：資料存在 Cloudflare KV，透過 Pages Functions 存取。
  // 不需要註冊第三方服務，也不需要 API 金鑰。
  (async () => {
    const nodes = Array.from(
      document.querySelectorAll<HTMLElement>('[data-views-slug]')
    );
    if (nodes.length === 0) return;

    const render = (el: HTMLElement, n: number | null) => {
      const target = el.querySelector('[data-views-value]');
      if (target) target.textContent = n === null ? '–' : n.toLocaleString('zh-TW');
    };

    const articleNode = nodes.find((n) => n.dataset.viewsMode === 'article');

    try {
      if (articleNode) {
        // 文章頁：累加一次。同一個瀏覽階段重複整理不重複計算。
        const slug = articleNode.dataset.viewsSlug!;
        const seenKey = `viewed:${slug}`;
        let counted = false;
        try {
          counted = sessionStorage.getItem(seenKey) === '1';
        } catch {
          /* 無痕模式等情況讀不到就當作沒看過 */
        }

        const res = await fetch(`/api/views/${encodeURIComponent(slug)}`, {
          method: counted ? 'GET' : 'POST',
        });
        const data = await res.json();
        render(articleNode, typeof data.views === 'number' ? data.views : null);

        if (!counted) {
          try {
            sessionStorage.setItem(seenKey, '1');
          } catch {
            /* 忽略 */
          }
        }
      } else {
        // 首頁卡片：一次把所有文章的次數抓回來
        const res = await fetch('/api/views');
        const counts = await res.json();
        for (const el of nodes) {
          const slug = el.dataset.viewsSlug!;
          render(el, typeof counts[slug] === 'number' ? counts[slug] : 0);
        }
      }
    } catch {
      for (const el of nodes) render(el, null);
    }
  })();
</script>
