---
interface Props {
  href: string;
  name: string;
  emoji: string;
  time: string;
  summary: string;
  who: string;
}
const { href, name, emoji, time, summary, who } = Astro.props;
---

<a
  href={href}
  class="group flex h-full min-w-0 flex-col rounded-2xl border border-line bg-panel p-6 transition-all hover:-translate-y-0.5 hover:border-accent hover:shadow-xl hover:shadow-deep/5"
>
  <div class="flex items-start justify-between gap-3">
    <span class="text-3xl leading-none" aria-hidden="true">{emoji}</span>
    <span class="shrink-0 rounded-full bg-surface px-2.5 py-1 text-[11px] font-bold text-muted">
      {time}
    </span>
  </div>

  <h3 class="mt-4 text-lg leading-snug font-bold break-words text-head group-hover:text-accent">
    {name}
  </h3>
  <p class="mt-2.5 flex-1 text-sm leading-relaxed break-words text-muted">{summary}</p>

  <p class="mt-4 border-t border-line pt-3.5 text-xs break-words text-muted">
    <span class="font-bold text-head">適合：</span>{who}
  </p>
  <span class="mt-3 text-sm font-bold text-accent">開始使用 →</span>
</a>
