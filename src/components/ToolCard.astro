---
import { Image } from 'astro:assets';
import { TOOL_IMAGES } from '../data/toolImages';

interface Props {
  href: string;
  name: string;
  emoji: string;
  time: string;
  summary: string;
  who: string;
}
const { href, name, emoji, time, summary, who } = Astro.props;

const bg = TOOL_IMAGES[href];
---

<a
  href={href}
  data-tool={href.replace('/tools/', '')}
  class:list={[
    'group relative isolate flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-line bg-panel p-6 transition-all hover:-translate-y-0.5 hover:border-linestrong hover:shadow-xl hover:shadow-black/20',
    // 有背景照片的卡片，內容永遠落在深色遮罩上 —— 所以文字要固定用深色版的顏色，
    // 否則淺色模式下會變成深色字疊在深色照片上，整張看不到。
    bg && 'on-dark',
  ]}
>
  {
    bg && (
      <>
        <Image
          src={bg.image}
          alt={bg.alt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
          class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover transition-transform duration-500 group-hover:scale-110"
          loading="lazy"
        />
        {/*
          遮罩由上往下加深：照片在卡片上半部看得清楚，
          文字落在下半部的深色區，白字在任何照片上都讀得清楚。
        */}
        <div
          class="absolute inset-0 -z-10 bg-gradient-to-b from-band/30 from-0% via-band/93 via-36% to-band/98 to-100%"
          aria-hidden="true"
        />
      </>
    )
  }

  <div class="flex items-start justify-between gap-3">
    <span class="text-3xl leading-none drop-shadow" aria-hidden="true">{emoji}</span>
    <span
      class="shrink-0 rounded-full border border-line bg-band/70 px-2.5 py-1 text-[11px] font-bold text-body backdrop-blur-sm"
    >
      {time}
    </span>
  </div>

  <h3 class="mt-4 text-lg leading-snug font-bold break-words text-head group-hover:text-accent">
    {name}
  </h3>
  <p class="mt-2.5 flex-1 text-sm leading-relaxed break-words text-body/90">{summary}</p>

  <p class="mt-4 border-t border-line pt-3.5 text-xs break-words text-body/80">
    <span class="font-bold text-head">適合：</span>{who}
  </p>
  <span class="mt-3 text-sm font-bold text-accent">開始使用 →</span>
</a>
