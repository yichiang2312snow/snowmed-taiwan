---
import { SITE, SITE_A, SITE_TESA, NAV, TOOLS, TOOL_CATEGORIES } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

/**
 * 選單第二列的站外連結（桌機一行一個，手機收在漢堡選單裡）。
 * 要再加第三個就在這裡多一筆，兩邊的版面都會自動跟上。
 */
const SIDE_LINKS = [
  { note: '醫師個人網站', label: SITE_A.introLabel, url: SITE_A.url },
  { note: SITE_TESA.note, label: SITE_TESA.label, url: SITE_TESA.url },
  // 近期活動報名。下面的 script 會去個人網站讀活動清單，把 label 換成最近一場的日期與名稱；
  // 真的一場都沒有的時候整列會收起來（跟個人網站上那個區塊的行為一致，不會叫人去報名空氣）。
  // 讀不到就維持這個通用標籤，連結本身永遠有效。
  { note: '近期活動報名', label: '楊醫師近期講座與實作課', url: SITE_A.eventsUrl, key: 'events' },
];

const path = Astro.url.pathname;
const isExternal = (href: string) => href.startsWith('http');
const isActive = (href: string) =>
  isExternal(href)
    ? false
    : href === '/'
      ? path === '/'
      : path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-5">
    <a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3">
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-panel text-accent sm:h-10 sm:w-10"
        aria-hidden="true"
      >
        <svg viewBox="0 0 100 100" class="h-5 w-5 sm:h-6 sm:w-6" fill="none">
          <path
            d="M50 18v64M22 34l56 32M78 34L22 66"
            stroke="currentColor"
            stroke-width="9"
            stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="min-w-0 leading-tight">
        <span class="block truncate text-[13px] font-black text-head sm:text-base">
          {SITE.name}
        </span>
        <span class="block truncate text-[10px] font-medium text-muted sm:text-[11px]">
          {SITE.tagline}
        </span>
      </span>
    </a>

    <!-- 桌機版選單 -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="主選單">
      {
        NAV.map((item) =>
          item.href === '/tools' ? (
            <div class="relative" data-tools-menu>
              <button
                type="button"
                id="tools-trigger"
                aria-expanded="false"
                aria-controls="tools-dropdown"
                aria-haspopup="true"
                class:list={[
                  'flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors',
                  isActive(item.href)
                    ? 'bg-tint2 text-head'
                    : 'text-muted hover:bg-tint1 hover:text-head',
                ]}
              >
                {item.label}
                <svg
                  viewBox="0 0 20 20"
                  class="h-3.5 w-3.5 transition-transform"
                  data-chevron
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M5.5 7.5 10 12l4.5-4.5z" />
                </svg>
              </button>

              <div
                id="tools-dropdown"
                class="absolute top-full right-0 z-50 mt-2 hidden w-80 overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl shadow-black/40"
              >
                <div class="max-h-[70vh] overflow-y-auto p-2">
                  {TOOL_CATEGORIES.map((cat, ci) => (
                    <div class:list={[ci > 0 && 'mt-2 border-t border-line pt-2']}>
                      <p class="px-3 pt-1.5 pb-1 text-[11px] font-black tracking-widest text-accent">
                        <span aria-hidden="true">{cat.emoji}</span> {cat.label}
                      </p>
                      <ul>
                        {TOOLS.filter((t) => t.category === cat.id).map((t) => (
                          <li>
                            <a
                              href={t.href}
                              class:list={[
                                'flex min-w-0 items-start gap-3 rounded-xl px-3 py-2.5 transition-colors',
                                path === t.href || path === t.href + '/'
                                  ? 'bg-tint2'
                                  : 'hover:bg-tint1',
                              ]}
                            >
                              <span class="text-lg leading-none" aria-hidden="true">
                                {t.emoji}
                              </span>
                              <span class="min-w-0">
                                <span class="block text-sm font-bold break-words text-head">
                                  {t.name}
                                </span>
                                <span class="block text-[11px] text-body">{t.time}</span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <a
                  href="/tools"
                  class="block border-t border-line px-4 py-3 text-sm font-bold text-accent hover:bg-tint1"
                  >查看所有工具 →</a
                >
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors',
                isActive(item.href)
                  ? 'bg-tint2 text-head'
                  : 'text-muted hover:bg-tint1 hover:text-head',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
              target={isExternal(item.href) ? '_blank' : undefined}
              rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
            >
              {item.label}
              {isExternal(item.href) && <span aria-hidden="true"> ↗</span>}
            </a>
          )
        )
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <ThemeToggle />

      <button
        type="button"
        id="nav-toggle"
        class="rounded-lg border border-line p-2 text-head transition-colors hover:bg-tint1 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">開啟選單</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <!--
    第二列：連到醫師個人網站。跟姊妹站的作法對稱 —— 那邊的第二列連過來這裡，
    兩站互相指認，不是單向導流。

    手機版不顯示：吸頂列再多一排會吃掉可視高度，改放在漢堡選單的最下面。
  -->
  <div class="hidden border-t border-line bg-panel/60 sm:block">
    <div class="mx-auto max-w-6xl px-4 py-1.5 sm:px-5">
      {
        SIDE_LINKS.map((link) => (
          <div class="flex h-7 items-center justify-end gap-2" data-side-row={link.key}>
            <span class="text-[11px] font-medium tracking-wider text-muted">{link.note}</span>
            <a
              href={link.url}
              target="_blank"
              rel="noopener"
              data-side-link={link.key}
              class="inline-flex items-center gap-1 rounded-full border border-line bg-surface px-3 py-1 text-xs font-bold whitespace-nowrap text-head transition-colors hover:border-accent hover:bg-tint1"
            >
              <span data-side-label>{link.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 行動版選單 -->
  <nav id="mobile-nav" class="hidden border-t border-line bg-bg lg:hidden" aria-label="行動版選單">
    <div class="mx-auto max-h-[75vh] max-w-6xl overflow-y-auto px-4 py-3 sm:px-5">
      {
        NAV.map((item) =>
          item.href === '/tools' ? (
            <div>
              <a
                href="/tools"
                class="block rounded-lg px-3 py-3 text-sm font-bold text-head hover:bg-tint2"
              >
                {item.label}
              </a>
              <div class="mt-1 mb-2 border-l border-line pl-3">
                {TOOL_CATEGORIES.map((cat, ci) => (
                  <div class:list={[ci > 0 && 'mt-3']}>
                    <p class="px-3 pb-1 text-[11px] font-black tracking-widest text-accent">
                      <span aria-hidden="true">{cat.emoji}</span> {cat.label}
                    </p>
                    <ul class="space-y-0.5">
                      {TOOLS.filter((t) => t.category === cat.id).map((t) => (
                        <li>
                          <a
                            href={t.href}
                            class="flex min-w-0 items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm text-body hover:bg-tint1"
                          >
                            <span aria-hidden="true">{t.emoji}</span>
                            <span class="min-w-0 break-words">{t.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class="block rounded-lg px-3 py-3 text-sm font-medium text-head hover:bg-tint2"
              target={isExternal(item.href) ? '_blank' : undefined}
              rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
            >
              {item.label}
              {isExternal(item.href) && <span aria-hidden="true"> ↗</span>}
            </a>
          )
        )
      }

      <!-- 桌機版放在第二列的那幾個，手機版收在這裡 -->
      {
        SIDE_LINKS.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener"
            data-side-row={link.key}
            data-side-link={link.key}
            class="mt-2 block rounded-lg border border-line px-3 py-3 text-sm font-bold text-head hover:bg-tint2"
          >
            {link.key === 'events' && (
              <span class="mr-1.5 rounded bg-tint2 px-1.5 py-0.5 text-[10px] font-bold text-head">
                {link.note}
              </span>
            )}
            <span data-side-label>{link.label}</span>
            <span aria-hidden="true"> ↗</span>
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  // ── 近期活動報名：把按鈕上的字換成最近一場 ──
  //
  // 活動資料只存在醫師個人網站一份（那邊是 SSR，過期會自動消失）。這個站是靜態的，
  // 建置當下的日期會被寫死在 HTML 裡，所以改成在瀏覽器端讀，隔多久沒重新部署都不會過期。
  // 讀不到就什麼都不做，維持原本的通用標籤 —— 連結本身永遠有效。
  (async () => {
    const rows = document.querySelectorAll<HTMLElement>('[data-side-row="events"]');
    if (!rows.length) return;

    type Ev = { monthDay: string; weekday: string; title: string; format: string; url: string | null };
    let events: Ev[];
    try {
      const res = await fetch('https://dr.snowmed-taiwan.com/api/upcoming-events.json');
      if (!res.ok) return;
      const data = (await res.json()) as { events?: Ev[] };
      if (!Array.isArray(data.events)) return;
      events = data.events;
    } catch {
      return; // 離線、被擋下來、或對面暫時掛了：維持原樣就好
    }

    // 一場都沒有就把整列收起來，不要叫人去報名空氣（跟個人網站那個區塊的行為一致）
    if (events.length === 0) {
      for (const row of rows) row.hidden = true;
      return;
    }

    const next = events[0];
    const title = next.title.length > 22 ? next.title.slice(0, 21) + '…' : next.title;
    const more = events.length > 1 ? ` 等 ${events.length} 場` : '';
    const label = `${next.monthDay}（${next.weekday}）${next.format} ${title}${more}`;

    for (const row of rows) {
      const el = row.matches('[data-side-link]') ? row : row.querySelector('[data-side-link]');
      const labelEl = row.querySelector('[data-side-label]');
      if (labelEl) labelEl.textContent = label;
      // 只有一場而且報名連結已經開放時，直接連到報名頁，少一次點擊
      if (el instanceof HTMLAnchorElement && events.length === 1 && next.url) el.href = next.url;
    }
  })();

  // 行動版選單
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // 桌機版「工具」下拉選單
  const trigger = document.getElementById('tools-trigger');
  const dropdown = document.getElementById('tools-dropdown');
  const wrapper = document.querySelector('[data-tools-menu]');
  const chevron = trigger?.querySelector('[data-chevron]');

  if (trigger && dropdown && wrapper) {
    const setOpen = (open: boolean) => {
      dropdown.classList.toggle('hidden', !open);
      trigger.setAttribute('aria-expanded', String(open));
      chevron?.classList.toggle('rotate-180', open);
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(dropdown.classList.contains('hidden'));
    });

    // 滑到選單上就打開，離開就收起 —— 滑鼠使用者不用點兩下
    let hoverTimer: number | undefined;
    wrapper.addEventListener('mouseenter', () => {
      window.clearTimeout(hoverTimer);
      setOpen(true);
    });
    wrapper.addEventListener('mouseleave', () => {
      hoverTimer = window.setTimeout(() => setOpen(false), 180);
    });

    // 點外面或按 Esc 都收起來
    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dropdown.classList.contains('hidden')) {
        setOpen(false);
        (trigger as HTMLButtonElement).focus();
      }
    });
  }
</script>
