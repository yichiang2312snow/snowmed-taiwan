---
import { SITE, NAV } from '../consts';
const path = Astro.url.pathname;
const isExternal = (href: string) => href.startsWith('http');
const isActive = (href: string) =>
  isExternal(href)
    ? false
    : href === '/'
      ? path === '/'
      : path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-5">
    <a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3">
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-bg text-accent sm:h-10 sm:w-10"
        aria-hidden="true"
      >
        <svg viewBox="0 0 100 100" class="h-5 w-5 sm:h-6 sm:w-6" fill="none">
          <path
            d="M50 18v64M22 34l56 32M78 34L22 66"
            stroke="currentColor"
            stroke-width="9"
            stroke-linecap="round"></path>
        </svg>
      </span>
      <span class="min-w-0 leading-tight">
        <span class="block truncate text-[13px] font-black text-head sm:text-base">
          {SITE.name}
        </span>
        <span class="block truncate text-[10px] font-medium text-muted sm:text-[11px]">
          {SITE.poweredByShort}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="主選單">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-white/12 text-head'
                : 'text-muted hover:bg-white/12 hover:text-head',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
            target={isExternal(item.href) ? '_blank' : undefined}
            rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
          >
            {item.label}
            {isExternal(item.href) && <span aria-hidden="true"> ↗</span>}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="shrink-0 rounded-lg border border-line p-2 text-head lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">開啟選單</span>
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line bg-surface lg:hidden" aria-label="行動版選單">
    <div class="mx-auto max-w-6xl px-4 py-3 sm:px-5">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="block rounded-lg px-3 py-3 text-sm font-medium text-head hover:bg-white/12"
            target={isExternal(item.href) ? '_blank' : undefined}
            rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
          >
            {item.label}
            {isExternal(item.href) && <span aria-hidden="true"> ↗</span>}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
