---
import { Image } from 'astro:assets';
import kneeImg from '../assets/anatomy/knee-anterior.png';
import ankleLateralImg from '../assets/anatomy/ankle-lateral.png';
import ankleMedialImg from '../assets/anatomy/ankle-medial.png';

/**
 * 渥太華規則的壓痛熱區圖。
 *
 * 底圖是真實的解剖圖（授權見 consts.ts 的 IMAGE_CREDITS），
 * 上面用 SVG 疊上紅／黃圈與編號 —— 編號對應工具頁清單裡的項目。
 * 座標用百分比，所以圖片縮放時標記會跟著跑對位置。
 */
interface Props {
  part: 'knee' | 'ankle';
}
const { part } = Astro.props;

type Marker = {
  /** 圓心位置（佔圖片寬高的百分比） */
  x: number;
  y: number;
  /** 圓的半徑（佔圖片寬度的百分比） */
  r: number;
  /** 拉長成直立橢圓（用在「往上 6 公分」那種帶狀範圍） */
  ry?: number;
  n: string;
  tone: 'red' | 'amber';
  /** 編號氣泡的位置 */
  lx: number;
  ly: number;
};

const KNEE: Marker[] = [
  { n: '3', tone: 'red', x: 47.5, y: 45, r: 13, ry: 16, lx: 82, ly: 33 },
  { n: '2', tone: 'amber', x: 16, y: 73.5, r: 8, lx: 4, ly: 88 },
];

const ANKLE_LATERAL: Marker[] = [
  { n: '2', tone: 'red', x: 32, y: 33, r: 5.5, ry: 13, lx: 10, ly: 16 },
  { n: '3', tone: 'amber', x: 50, y: 57, r: 6, lx: 68, ly: 76 },
];

const ANKLE_MEDIAL: Marker[] = [
  { n: '1', tone: 'red', x: 67, y: 33, r: 5.5, ry: 13, lx: 89, ly: 16 },
  { n: '4', tone: 'amber', x: 48, y: 55, r: 6, lx: 28, ly: 76 },
];

const TONE = {
  red: { stroke: '#ef4444', fill: 'rgba(239,68,68,0.2)', text: '#ffffff' },
  amber: { stroke: '#f59e0b', fill: 'rgba(245,158,11,0.22)', text: '#1a1a1a' },
};

const figures =
  part === 'knee'
    ? [
        {
          img: kneeImg,
          alt: '右膝正面解剖圖，標示髕骨與腓骨頭兩個壓痛位置',
          title: '膝蓋的壓痛位置',
          note: '右腳、從正面看（外側在畫面左邊）。編號對應下面清單裡的項目。',
          markers: KNEE,
          legend: [
            ['② 腓骨頭', '膝蓋外側、關節線再往下約一個指幅可以摸到的骨頭突起'],
            ['③ 髕骨', '膝蓋正前方可以左右推動的圓骨。重點是「只有這裡痛」'],
          ],
        },
      ]
    : [
        {
          img: ankleLateralImg,
          alt: '右腳外側解剖圖，標示外踝上方六公分範圍與第五蹠骨基部',
          title: '外側面',
          note: '右腳、從外側看，腳尖朝右。',
          markers: ANKLE_LATERAL,
          legend: [
            ['② 外踝上方 6 公分', '從外踝最高點往小腿方向約四指寬，沿骨頭後緣按壓'],
            ['③ 第五蹠骨基部', '腳掌外側中段，從小趾往腳跟摸會摸到的突起'],
          ],
        },
        {
          img: ankleMedialImg,
          alt: '右腳內側解剖圖，標示內踝上方六公分範圍與舟狀骨',
          title: '內側面',
          note: '右腳、從內側看，腳尖朝左。',
          markers: ANKLE_MEDIAL,
          legend: [
            ['① 內踝上方 6 公分', '從內踝最高點往小腿方向約四指寬，沿骨頭後緣按壓'],
            ['④ 舟狀骨', '腳掌內側中段，足弓最高處前方的骨頭突起'],
          ],
        },
      ];
---

<div class:list={['grid min-w-0 gap-4', part === 'ankle' && 'sm:grid-cols-2']}>
  {
    figures.map((f) => (
      <figure class="min-w-0 rounded-2xl border border-line bg-surface p-5">
        <figcaption class="mb-1 text-sm font-bold text-head">{f.title}</figcaption>
        <p class="mb-4 text-xs leading-relaxed break-words text-muted">{f.note}</p>

        {/* 解剖圖固定放在白底上，深色淺色模式看起來都一樣清楚 */}
        <div class="relative mx-auto w-full max-w-[340px] overflow-hidden rounded-xl bg-white">
          <Image
            src={f.img}
            alt={f.alt}
            widths={[340, 680]}
            sizes="(max-width: 640px) 100vw, 340px"
            class="block h-auto w-full"
            loading="lazy"
          />

          <svg
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            class="pointer-events-none absolute inset-0 h-full w-full"
            aria-hidden="true"
          >
            {f.markers.map((m) => (
              <ellipse
                cx={m.x}
                cy={m.y}
                rx={m.r}
                ry={m.ry ?? m.r}
                fill={TONE[m.tone].fill}
                stroke={TONE[m.tone].stroke}
                stroke-width="1.1"
                vector-effect="non-scaling-stroke"
              />
            ))}
          </svg>

          {/* 編號氣泡另外用絕對定位，才不會被 viewBox 拉扁 */}
          {f.markers.map((m) => (
            <span
              class="absolute flex h-7 w-7 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full text-sm font-black shadow"
              style={`left:${m.lx}%;top:${m.ly}%;background:${TONE[m.tone].stroke};color:${TONE[m.tone].text}`}
              aria-hidden="true"
            >
              {m.n}
            </span>
          ))}
        </div>

        <ul class="mt-4 space-y-1.5 text-xs break-words text-muted">
          {f.legend.map(([term, desc]) => (
            <li>
              <span class="font-bold text-head">{term}</span>：{desc}
            </li>
          ))}
        </ul>
      </figure>
    ))
  }
</div>
