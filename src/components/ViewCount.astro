---
interface Props {
  slug: string;
  /** index = 首頁卡片（只讀取不累加）；article = 文章頁（累加一次） */
  mode?: 'index' | 'article';
  class?: string;
}
const { slug, mode = 'index', class: cls = '' } = Astro.props;
---

<span
  class:list={['inline-flex items-center gap-1.5 tabular-nums', cls]}
  data-views-slug={slug}
  data-views-mode={mode}
  title="瀏覽次數"
>
  <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
    <path
      d="M10 4c-4 0-7.3 2.6-9 6 1.7 3.4 5 6 9 6s7.3-2.6 9-6c-1.7-3.4-5-6-9-6Zm0 10a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-6a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z"
    ></path>
  </svg>
  <span class="sr-only">瀏覽次數</span>
  <span data-views-value>–</span>
</span>
