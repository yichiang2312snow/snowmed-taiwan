---
interface Props {
  tone?: 'snow' | 'white' | 'ice';
  class?: string;
}
const { tone = 'snow', class: cls = '' } = Astro.props;
const bg = { snow: 'bg-snow', white: 'bg-white', ice: 'bg-ice/50' }[tone];
---

<section class={`${bg} ${cls}`}>
  <div class="mx-auto max-w-5xl px-5 py-14 sm:py-20">
    <slot />
  </div>
</section>
