---
/**
 * 回歸雪場準備度：人形圖 + 六題分級評估，下方給階段判斷與最弱環節。
 *
 * 版面與腦震盪、疲勞、受傷分流三頁一致（左右兩欄卡片 + 中間人形 + JS 畫連線），
 * 差別在這裡每一題是四選一的程度題（0–3 分），不是勾選有沒有 ——
 * 因為回歸運動的判斷本來就不是二分法。
 *
 * 計分刻意設計成「最弱的那一項會拉低整體判斷」，而不是加總平均：
 * 回歸運動的風險由最弱的環節決定。
 */
import { RTS_QUESTIONS } from '../data/returnToSnowQuestions';

const left = RTS_QUESTIONS.filter((q) => q.side === 'left').sort((a, b) => a.n - b.n);
const right = RTS_QUESTIONS.filter((q) => q.side === 'right').sort((a, b) => a.n - b.n);

// 最弱環節的說明交給前端用，避免在兩個地方各寫一份
const GAPS = Object.fromEntries(RTS_QUESTIONS.map((q) => [q.id, q.gap]));
const DOMAINS = Object.fromEntries(RTS_QUESTIONS.map((q) => [q.id, q.domain]));
const KEYS = RTS_QUESTIONS.map((q) => q.id);

// 人形（以身體中線為 x = 0），跟其他人形圖用同一套
const ARMS = [
  [-66, 160, -84, 262, -92, 352],
  [66, 160, 84, 262, 92, 352],
];
const LEGS = [
  [-26, 360, -32, 480, -36, 576],
  [26, 360, 32, 480, 36, 576],
];
const TORSO =
  'M-58,150 Q0,138 58,150 Q74,156 74,172 Q78,262 50,372 L-50,372 Q-78,262 -74,172 Q-74,156 -58,150 Z';
const pts = (a: number[]) => a.join(' ');
---

<div>
  <p class="text-sm leading-relaxed break-words text-muted">
    六個面向分別檢查身體的不同環節。<strong class="text-head">六題都要選一個</strong>，
    下面會告訴你目前在哪一個階段、以及最弱的是哪一環。手機可以點人形圖上的號碼，跳到對應的題目。
  </p>

  <form id="rts-form" class="mt-5">
    <div
      id="rts-map"
      class="relative grid gap-4 md:grid-cols-[minmax(0,1fr)_200px_minmax(0,1fr)] md:gap-x-6"
    >
      {/* 連線層：寬螢幕時由 JS 畫，把卡片連到人形上的點 */}
      <svg
        id="rts-lines"
        class="pointer-events-none absolute inset-0 hidden h-full w-full md:block"
        aria-hidden="true"></svg>

      {/* 人形：手機時在最上面，寬螢幕時在中間 */}
      <div
        class="order-first mx-auto w-full max-w-[220px] md:order-none md:col-start-2 md:row-start-1 md:max-w-none md:self-start md:sticky md:top-24"
      >
        <svg
          id="rts-figure"
          viewBox="-125 30 250 590"
          class="h-auto w-full"
          role="img"
          aria-label="人形示意圖，上面標了 6 個號碼，對應回歸雪場評估的六個面向"
          style="font-family: inherit"
        >
          <g>
            {/* 先畫一層外框色、再疊一層填色，拼起來就是乾淨的剪影輪廓 */}
            {[
              { color: 'var(--color-linestrong)', grow: 6 },
              { color: 'var(--color-panel)', grow: 0 },
            ].map(({ color, grow }) => (
              <g
                style={`fill:${color};stroke:${color}`}
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {LEGS.map((l) => (
                  <polyline points={pts(l)} style={`fill:none;stroke-width:${36 + grow}`} />
                ))}
                {ARMS.map((a) => (
                  <polyline points={pts(a)} style={`fill:none;stroke-width:${26 + grow}`} />
                ))}
                <path d={TORSO} style={`stroke-width:${grow}`} />
                <rect x="-14" y="118" width="28" height="40" rx="6" style={`stroke-width:${grow}`} />
                <circle cx="0" cy="85" r="42" style={`stroke-width:${grow}`} />
                <circle cx="-94" cy="372" r="15" style={`stroke-width:${grow}`} />
                <circle cx="94" cy="372" r="15" style={`stroke-width:${grow}`} />
                <ellipse cx="-44" cy="594" rx="25" ry="11" style={`stroke-width:${grow}`} />
                <ellipse cx="44" cy="594" rx="25" ry="11" style={`stroke-width:${grow}`} />
              </g>
            ))}

            {/* 兩側膝關節：這一頁大部分的評估都繞著膝蓋，標出來比較好對應 */}
            <g style="fill:none;stroke:var(--color-linestrong);stroke-width:1.6">
              <circle cx="-32" cy="478" r="17" />
              <circle cx="32" cy="478" r="17" />
            </g>
          </g>

          {/* 標記點：每個面向一個號碼，連線就指到這裡 */}
          {RTS_QUESTIONS.map((q) =>
            q.targets.map(([x, y]) => (
              <g class="rts-marker" data-q={q.id}>
                <circle
                  cx={x}
                  cy={y}
                  r="13"
                  style="fill:var(--color-band);stroke:var(--color-accent);stroke-width:2"
                />
                <text
                  x={x}
                  y={y}
                  text-anchor="middle"
                  dominant-baseline="central"
                  font-size="14"
                  font-weight="900"
                  style="fill:#ffffff"
                >
                  {q.n}
                </text>
              </g>
            ))
          )}
        </svg>
        <p class="mt-1 text-center text-[11px] text-muted md:hidden">號碼對應下方的題目</p>
      </div>

      {[
        { side: 'left', list: left },
        { side: 'right', list: right },
      ].map(({ side, list }) => (
        <div
          class:list={[
            'space-y-4',
            side === 'left' ? 'md:col-start-1' : 'md:col-start-3',
            'md:row-start-1',
          ]}
        >
          {list.map((q) => (
            <fieldset
              class="rts-card min-w-0 rounded-2xl border border-line bg-surface p-4 transition-colors has-[:checked]:border-accent sm:p-5"
              data-q={q.id}
              data-side={side}
            >
              <legend class="flex items-center gap-2 px-1">
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-band text-xs font-black text-white ring-2 ring-accent"
                  aria-hidden="true"
                >
                  {q.n}
                </span>
                <span class="text-sm font-black text-head">{q.domain}</span>
              </legend>

              <h3 class="mt-2 text-sm leading-snug font-bold break-words text-head">{q.q}</h3>
              <p class="mt-1.5 text-xs leading-relaxed break-words text-muted">{q.hint}</p>

              <div class="mt-3 grid gap-2">
                {q.options.map((o) => (
                  <label class="flex min-w-0 cursor-pointer items-center gap-3 rounded-xl border border-line bg-panel px-3.5 py-2.5 text-sm transition-colors has-[:checked]:border-accent has-[:checked]:bg-tint2">
                    <input
                      type="radio"
                      name={q.id}
                      value={o.score}
                      class="h-4 w-4 shrink-0 accent-[var(--color-accent)]"
                    />
                    <span class="min-w-0 leading-relaxed break-words text-head">{o.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
      ))}
    </div>

    <p id="rts-error" class="mt-5 rounded-xl bg-tint2 px-4 py-3 text-sm font-bold text-head" hidden>
      還有題目沒有作答，請六題都選完再送出。
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <p class="text-sm font-bold text-head">
        已作答 <span id="rts-count" class="text-accent tabular-nums">0</span> / {RTS_QUESTIONS.length} 題
      </p>
      <div class="flex flex-1 flex-wrap justify-end gap-3">
        <button
          type="submit"
          class="flex-1 rounded-xl bg-cta px-6 py-4 text-sm font-bold text-ctatext transition-colors hover:bg-accent sm:flex-none"
        >
          看我到哪個階段了
        </button>
        <button
          type="reset"
          id="rts-reset"
          class="rounded-xl border border-line bg-panel px-6 py-4 text-sm font-bold text-head hover:bg-tint1"
        >
          重新評估
        </button>
      </div>
    </div>
  </form>

  <!-- 結果 -->
  <div id="rts-result" class="mt-8 scroll-mt-20" hidden>
    <div id="rts-box" class="rounded-2xl border-l-4 p-6 sm:p-8">
      <p class="text-xs font-black tracking-widest text-muted uppercase">你的階段</p>
      <p id="rts-stage" class="mt-3 text-xl font-black break-words sm:text-2xl"></p>
      <p id="rts-summary" class="mt-3 text-sm leading-relaxed break-words text-head"></p>

      <div class="mt-6 rounded-xl bg-tint1 p-5">
        <p class="text-sm font-bold text-head">下一步建議</p>
        <ul id="rts-next" class="mt-2.5 space-y-2 text-sm leading-relaxed break-words text-muted"></ul>
      </div>

      <div id="rts-gap-wrap" class="mt-5 rounded-xl bg-tint1 p-5" hidden>
        <p class="text-sm font-bold text-head">
          目前最弱的環節：<span id="rts-gap-domain" class="text-accent"></span>
        </p>
        <p id="rts-gap" class="mt-1.5 text-sm leading-relaxed break-words text-muted"></p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ GAPS, DOMAINS, KEYS }}>
  const form = document.getElementById('rts-form');
  const result = document.getElementById('rts-result');
  const map = document.getElementById('rts-map');
  const lines = document.getElementById('rts-lines');
  const errorBox = document.getElementById('rts-error');
  const countEl = document.getElementById('rts-count');
  const wide = window.matchMedia('(min-width: 768px)');

  // ── 連線：把每張卡片連到人形上的號碼點（只在寬螢幕畫） ──
  function drawLines() {
    if (!map || !lines) return;
    lines.textContent = '';
    if (!wide.matches) return;
    const box = map.getBoundingClientRect();
    lines.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);

    for (const card of Array.from(map.querySelectorAll('.rts-card'))) {
      const id = card.dataset.q;
      const cb = card.getBoundingClientRect();
      const active = card.querySelector('input:checked') !== null;
      const ax = card.dataset.side === 'left' ? cb.right - box.left : cb.left - box.left;
      const ay = cb.top - box.top + 22;

      map.querySelectorAll(`.rts-marker[data-q="${id}"]`).forEach((m) => {
        const mb = m.getBoundingClientRect();
        const tx = mb.left + mb.width / 2 - box.left;
        const ty = mb.top + mb.height / 2 - box.top;
        const midx = card.dataset.side === 'left' ? ax + 14 : ax - 14;
        const d = `M${ax},${ay} L${midx},${ay} L${tx},${ty}`;
        for (const [stroke, width] of [
          ['var(--color-panel)', '5'],
          [active ? 'var(--color-accent)' : 'var(--color-muted)', active ? '2.5' : '1.5'],
        ]) {
          const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          p.setAttribute('d', d);
          p.setAttribute('fill', 'none');
          p.setAttribute('stroke', stroke);
          p.setAttribute('stroke-width', width);
          p.setAttribute('stroke-linejoin', 'round');
          p.setAttribute('stroke-linecap', 'round');
          lines.append(p);
        }
        const circle = m.querySelector('circle');
        if (circle) circle.style.fill = active ? 'var(--color-accent)' : 'var(--color-band)';
        const text = m.querySelector('text');
        if (text) text.style.fill = active ? 'var(--color-ctatext, #08243c)' : '#ffffff';
      });
    }
  }

  // 手機：點人形上的號碼，捲到對應的題目
  map?.querySelectorAll('.rts-marker').forEach((m) => {
    m.style.cursor = 'pointer';
    m.addEventListener('click', () => {
      const card = map.querySelector(`.rts-card[data-q="${m.dataset.q}"]`);
      card?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card?.classList.add('ring-2', 'ring-accent');
      setTimeout(() => card?.classList.remove('ring-2', 'ring-accent'), 1600);
    });
  });

  let raf = 0;
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(drawLines);
  };
  window.addEventListener('resize', schedule);
  window.addEventListener('load', schedule);
  document.fonts?.ready.then(schedule);
  schedule();

  if (form && result) {
    const answered = () => KEYS.filter((k) => form.querySelector(`input[name="${k}"]:checked`));

    const updateCount = () => {
      if (countEl) countEl.textContent = String(answered().length);
      schedule();
    };
    form.addEventListener('change', updateCount);

    const STAGES = [
      {
        title: '階段一：還在復健期，先不要規劃行程',
        cls: 'border-red-500 bg-red-500/15',
        summary:
          '目前至少有一項指標明顯落後。這個階段上雪場，再次受傷的風險很高，而且可能造成比第一次更難處理的傷勢。',
        next: [
          '先處理最弱的那一項（見下方）。',
          '如果還有疼痛或腫脹，請先回診確認原因，不要自己加強訓練。',
          '這個階段的重點是把基礎補起來，而不是趕進度。',
          '等到六項都至少到「有差距」以上，再重新評估一次。',
        ],
      },
      {
        title: '階段二：進行中，距離回歸還有一段',
        cls: 'border-orange-400 bg-orange-500/15',
        summary:
          '你已經脫離急性期，但肌力或功能上仍有明顯缺口。再給自己 2–3 個月的時間，把差距補到九成左右。',
        next: [
          '肌力訓練以患側的單側動作為主，並定期記錄左右差距。',
          '加入漸進式跳躍訓練：雙腳 → 單腳 → 側向。',
          '每 4–6 週重測一次單腳跳，看數字有沒有在進步。',
          '同時開始規劃回歸行程，但先不要訂機票。',
        ],
      },
      {
        title: '階段三：接近準備好了，可以開始規劃',
        cls: 'border-amber-400 bg-amber-500/15',
        summary:
          '大部分指標已經接近標準。可以開始規劃一趟「降級版」的回歸行程，但請務必和你的醫師或治療師確認過。',
        next: [
          '把最後的缺口補到九成以上，特別是落地控制與心理準備度。',
          '選壓雪品質穩定、纜車方便、有緩坡可以慢慢來的雪場。',
          '第一天只滑半天、綠線為主；每天滑行時間比以前少三到四成。',
          '目標不是滑得多難，是確認身體的回饋是正常的 —— 沒有腫、沒有軟腳、隔天恢復正常。',
        ],
      },
      {
        title: '階段四：各項指標都達標',
        cls: 'border-emerald-400 bg-emerald-500/15',
        summary:
          '六個面向都到位了。這代表你的身體具備回到雪上的條件 —— 但第一趟仍然建議降級，讓身體在真實的雪況下再驗證一次。',
        next: [
          '第一趟仍然：半天、緩坡、避開深雪與樹林區。',
          '觀察隔天的反應。有腫脹或不適就退回去，不要硬撐。',
          '維持訓練。回歸之後最常見的錯誤是停止練，然後肌力慢慢掉回去。',
          '如果要恢復到受傷前的難度，建議分兩到三趟逐步加上去。',
        ],
      },
    ];

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const scores = {};
      for (const k of KEYS) {
        const el = form.querySelector(`input[name="${k}"]:checked`);
        if (!el) {
          if (errorBox) errorBox.hidden = false;
          return;
        }
        scores[k] = Number(el.value);
      }
      if (errorBox) errorBox.hidden = true;

      const total = KEYS.reduce((s, k) => s + scores[k], 0);
      const min = Math.min(...KEYS.map((k) => scores[k]));

      // 最弱的環節會拉低整體判斷 —— 風險由最弱的一項決定，不是由平均決定
      let stage;
      if (min === 0) stage = 0;
      else if (min === 1 || total < 12) stage = 1;
      else if (total < 16) stage = 2;
      else stage = 3;

      const s = STAGES[stage];
      const box = document.getElementById('rts-box');
      if (box) box.className = `rounded-2xl border-l-4 p-6 sm:p-8 ${s.cls}`;

      const setText = (id, text) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      setText('rts-stage', s.title);
      setText('rts-summary', s.summary);

      const next = document.getElementById('rts-next');
      if (next) {
        next.textContent = '';
        for (const n of s.next) {
          const li = document.createElement('li');
          li.className = 'flex gap-2.5';
          const dot = document.createElement('span');
          dot.className = 'shrink-0 text-accent';
          dot.textContent = '·';
          const span = document.createElement('span');
          span.className = 'min-w-0';
          span.textContent = n;
          li.append(dot, span);
          next.append(li);
        }
      }

      const weakKey = KEYS.reduce((a, b) => (scores[a] <= scores[b] ? a : b));
      const gapWrap = document.getElementById('rts-gap-wrap');
      if (gapWrap) {
        if (stage < 3) {
          setText('rts-gap-domain', DOMAINS[weakKey]);
          setText('rts-gap', GAPS[weakKey]);
          gapWrap.hidden = false;
        } else {
          gapWrap.hidden = true;
        }
      }

      window.snowmedTrack?.('done', 'return-to-snow');
      window.snowmedTrack?.('result', 'return-to-snow/stage' + (stage + 1));

      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    document.getElementById('rts-reset')?.addEventListener('click', () => {
      result.hidden = true;
      if (errorBox) errorBox.hidden = true;
      setTimeout(updateCount, 0);
    });
  }
</script>
