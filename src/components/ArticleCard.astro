---
import { Image } from 'astro:assets';
import ViewCount from './ViewCount.astro';
import { formatDate, isUpdated } from '../lib/format';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  updated: Date | null;
  author: string;
  category: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { slug, title, description, date, updated, author, category, image, imageAlt } =
  Astro.props;

const showUpdated = isUpdated(date, updated);
---

<article
  class="group relative flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-line bg-panel transition-shadow hover:shadow-xl hover:shadow-deep/5"
>
  {
    image && (
      <div class="aspect-[16/7] w-full overflow-hidden bg-white/12">
        <Image
          src={image}
          alt={imageAlt ?? ''}
          widths={[400, 800]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="flex min-w-0 flex-1 flex-col p-6">
    <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
      <span class="rounded-full bg-white/12 px-3 py-1 font-bold text-head">{category}</span>
      <time datetime={date.toISOString()} class="text-muted">
        {formatDate(date)}
      </time>
      {
        showUpdated && updated && (
          <span class="text-muted">· 更新於 {formatDate(updated)}</span>
        )
      }
    </div>

    <h2 class="text-lg leading-snug font-bold break-words text-head sm:text-xl">
      <a href={`/${slug}`} class="after:absolute after:inset-0 group-hover:text-accent">
        {title}
      </a>
    </h2>

    <p class="mt-2.5 line-clamp-3 text-sm leading-relaxed break-words text-muted">
      {description}
    </p>

    <div
      class="mt-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-line pt-4 text-xs text-muted"
    >
      <span class="min-w-0 truncate">{author}</span>
      <ViewCount slug={slug} mode="index" class="shrink-0" />
    </div>
  </div>
</article>
