---
/**
 * 腦震盪症狀自我檢查：人形圖 + 可勾選的症狀，下方依勾選結果給建議。
 *
 * 版面沿用「雪場受傷分流判斷」那一套（左右兩欄卡片 + 中間人形 + JS 畫連線），
 * 差別在這裡的症狀分兩級：紅點＝SCAT6 紅旗症狀，黃點＝其他可能出現的症狀。
 *
 * ⚠️ 這不是診斷工具。結論只回答「接下來該做什麼」，不回答「我有沒有腦震盪」——
 * 腦震盪的診斷需要醫師面對面評估，頁面上與結果區都必須保留這句話。
 */
import { BODY_REGIONS } from '../data/concussionSymptoms';

// 每個部位給一個號碼，手機版靠號碼對應（寬螢幕才有連線）
const regions = BODY_REGIONS.map((r, i) => ({ ...r, n: i + 1 }));
const left = regions.filter((r) => r.side === 'left');
const right = regions.filter((r) => r.side === 'right');

// 人形（以身體中線為 x = 0），跟受傷分流頁用同一套
const ARMS = [
  [-66, 160, -84, 262, -92, 352],
  [66, 160, 84, 262, 92, 352],
];
const LEGS = [
  [-26, 360, -32, 480, -36, 576],
  [26, 360, 32, 480, 36, 576],
];
const TORSO =
  'M-58,150 Q0,138 58,150 Q74,156 74,172 Q78,262 50,372 L-50,372 Q-78,262 -74,172 Q-74,156 -58,150 Z';
const pts = (a: number[]) => a.join(' ');
---

<div>
  <p class="text-sm leading-relaxed break-words text-muted">
    <span class="inline-block h-2.5 w-2.5 rounded-full align-middle" style="background:#ef4444"></span>
    <strong class="text-head">紅點</strong>是必須立刻就醫的警訊，
    <span class="inline-block h-2.5 w-2.5 rounded-full align-middle" style="background:#f59e0b"></span>
    <strong class="text-head">黃點</strong>是其他可能出現的症狀。手機可以點人形圖上的號碼，跳到對應的清單。
  </p>

  <form id="cc-form" class="mt-5">
    <div
      id="cc-map"
      class="relative grid gap-4 md:grid-cols-[minmax(0,1fr)_200px_minmax(0,1fr)] md:gap-x-6"
    >
      {/* 連線層：寬螢幕時由 JS 畫，把卡片連到人形上的點 */}
      <svg
        id="cc-lines"
        class="pointer-events-none absolute inset-0 hidden h-full w-full md:block"
        aria-hidden="true"></svg>

      {/* 人形：手機時在最上面，寬螢幕時在中間 */}
      <div
        class="order-first mx-auto w-full max-w-[220px] md:order-none md:col-start-2 md:row-start-1 md:max-w-none md:self-start md:sticky md:top-24"
      >
        <svg
          id="cc-figure"
          viewBox="-125 30 250 590"
          class="h-auto w-full"
          role="img"
          aria-label="人形示意圖，上面標了 6 個號碼，對應各部位可能出現的腦震盪症狀"
          style="font-family: inherit"
        >
          <g>
            {/* 先畫一層外框色、再疊一層填色，拼起來就是乾淨的剪影輪廓 */}
            {[
              { color: 'var(--color-linestrong)', grow: 6 },
              { color: 'var(--color-panel)', grow: 0 },
            ].map(({ color, grow }) => (
              <g
                style={`fill:${color};stroke:${color}`}
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {LEGS.map((l) => (
                  <polyline points={pts(l)} style={`fill:none;stroke-width:${36 + grow}`} />
                ))}
                {ARMS.map((a) => (
                  <polyline points={pts(a)} style={`fill:none;stroke-width:${26 + grow}`} />
                ))}
                <path d={TORSO} style={`stroke-width:${grow}`} />
                <rect x="-14" y="118" width="28" height="40" rx="6" style={`stroke-width:${grow}`} />
                <circle cx="0" cy="85" r="42" style={`stroke-width:${grow}`} />
                <circle cx="-94" cy="372" r="15" style={`stroke-width:${grow}`} />
                <circle cx="94" cy="372" r="15" style={`stroke-width:${grow}`} />
                <ellipse cx="-44" cy="594" rx="25" ry="11" style={`stroke-width:${grow}`} />
                <ellipse cx="44" cy="594" rx="25" ry="11" style={`stroke-width:${grow}`} />
              </g>
            ))}

            {/* 大腦、眼睛、胃：讓「連到哪裡」一眼就看得出來 */}
            <g style="stroke:var(--color-linestrong);stroke-width:1.6" stroke-linecap="round">
              <ellipse cx="0" cy="67" rx="28" ry="19" style="fill:var(--color-tint2)" />
              <path d="M0,49 L0,85 M-17,58 q7,6 0,13 M17,58 q-7,6 0,13" style="fill:none" />
              <path
                d="M8,270 C24,262 42,270 40,290 C38,310 18,314 8,304 C2,298 10,290 2,286 C-6,282 -4,274 8,270 Z"
                style="fill:var(--color-tint2)"
              />
            </g>
            <circle cx="-14" cy="101" r="3.5" style="fill:var(--color-linestrong)" />
            <circle cx="14" cy="101" r="3.5" style="fill:var(--color-linestrong)" />
          </g>

          {/* 標記點：每個部位一個號碼，連線就指到這裡 */}
          {regions.map((r) =>
            r.targets.map(([x, y]) => (
              <g class="cc-marker" data-region={r.id}>
                <circle
                  cx={x}
                  cy={y}
                  r="13"
                  style="fill:var(--color-band);stroke:var(--color-accent);stroke-width:2"
                />
                <text
                  x={x}
                  y={y}
                  text-anchor="middle"
                  dominant-baseline="central"
                  font-size="14"
                  font-weight="900"
                  style="fill:#ffffff"
                >
                  {r.n}
                </text>
              </g>
            ))
          )}
        </svg>
        <p class="mt-1 text-center text-[11px] text-muted md:hidden">號碼對應下方的症狀清單</p>
      </div>

      {[
        { side: 'left', list: left },
        { side: 'right', list: right },
      ].map(({ side, list }) => (
        <div
          class:list={[
            'space-y-4',
            side === 'left' ? 'md:col-start-1' : 'md:col-start-3',
            'md:row-start-1',
          ]}
        >
          {list.map((r) => (
            <fieldset
              class="cc-card min-w-0 rounded-2xl border border-line bg-surface p-4 transition-colors has-[:checked]:border-accent sm:p-5"
              data-region={r.id}
              data-side={side}
            >
              <legend class="flex items-center gap-2 px-1">
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-band text-xs font-black text-white ring-2 ring-accent"
                  aria-hidden="true"
                >
                  {r.n}
                </span>
                <span class="text-sm font-black text-head">{r.title}</span>
              </legend>

              <div class="mt-3 grid gap-2">
                {[
                  ...r.red.map((t) => ({ text: t, level: 'red' as const })),
                  ...r.other.map((t) => ({ text: t, level: 'other' as const })),
                ].map((item) => (
                  <label class="flex min-w-0 cursor-pointer items-start gap-2.5 rounded-xl border border-line bg-panel px-3.5 py-2.5 text-sm transition-colors has-[:checked]:border-accent has-[:checked]:bg-tint2">
                    <input
                      type="checkbox"
                      name="symptom"
                      value={item.text}
                      data-level={item.level}
                      class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-accent)]"
                    />
                    <span
                      class="mt-1.5 h-2 w-2 shrink-0 rounded-full"
                      style={`background:${item.level === 'red' ? '#ef4444' : '#f59e0b'}`}
                      aria-hidden="true"
                    />
                    <span class="min-w-0 leading-relaxed break-words text-head">{item.text}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <button
        type="submit"
        class="flex-1 rounded-xl bg-cta px-6 py-4 text-sm font-bold text-ctatext transition-colors hover:bg-accent"
      >
        看我該怎麼做
      </button>
      <button
        type="reset"
        id="cc-reset"
        class="rounded-xl border border-line bg-panel px-6 py-4 text-sm font-bold text-head hover:bg-tint1"
      >
        清除
      </button>
    </div>
  </form>

  <!-- 結果 -->
  <div id="cc-result" class="mt-8 scroll-mt-20" hidden>
    <div id="cc-box" class="rounded-2xl border-l-4 p-6 sm:p-8">
      <p class="text-xs font-black tracking-widest text-muted uppercase">建議行動</p>
      <p class="mt-3 flex flex-wrap items-center gap-3">
        <span id="cc-emoji" class="text-4xl leading-none" aria-hidden="true"></span>
        <span id="cc-title" class="text-xl font-black break-words sm:text-2xl"></span>
      </p>
      <p id="cc-lead" class="mt-3 text-sm leading-relaxed break-words text-head"></p>

      <ul id="cc-actions" class="mt-5 space-y-3 text-sm leading-relaxed break-words text-head"></ul>

      <div id="cc-flags-wrap" class="mt-6 rounded-xl bg-tint1 p-5" hidden>
        <p class="text-sm font-bold text-head">你勾選的項目中，觸發這個判斷的是：</p>
        <ul id="cc-flags" class="mt-2 space-y-1.5 text-sm break-words text-muted"></ul>
      </div>

      <div id="cc-others-wrap" class="mt-4 rounded-xl bg-tint1 p-5" hidden>
        <p class="text-sm font-bold text-head">其他勾選的症狀（同樣要告訴醫師）：</p>
        <ul id="cc-others" class="mt-2 space-y-1.5 text-sm break-words text-muted"></ul>
      </div>
    </div>

    <p class="mt-4 rounded-xl border border-line bg-panel px-5 py-4 text-xs leading-relaxed break-words text-muted">
      <strong class="text-head">這個結果不是診斷。</strong>
      腦震盪無法用症狀清單確認或排除，需要醫師面對面評估。這裡只回答「接下來該做什麼」；
      沒有勾到任何一項，也不代表沒有腦震盪 —— 症狀可能延遲數小時甚至隔天才出現。
    </p>
  </div>

  <figcaption class="mt-6 space-y-2 text-xs leading-relaxed break-words">
    <p class="flex items-start gap-2 text-body">
      <span
        class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full"
        style="background:#ef4444"
        aria-hidden="true"></span>
      <span
        ><strong class="text-head">紅點</strong>：出現任何一項，立刻停止活動並就醫（就是上面紅框裡的症狀）</span
      >
    </p>
    <p class="flex items-start gap-2 text-body">
      <span
        class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full"
        style="background:#f59e0b"
        aria-hidden="true"></span>
      <span
        ><strong class="text-head">黃點</strong>：其他可能出現的症狀 ——
        當天不要再滑，並把觀察到的狀況告訴醫師</span
      >
    </p>
    <p class="text-muted">
      這張圖只是把症狀對應到身體位置，方便一眼看懂，不能用來判斷有沒有腦震盪。
    </p>
  </figcaption>
</div>

<script>
  const form = document.getElementById('cc-form') as HTMLFormElement | null;
  const result = document.getElementById('cc-result');
  const map = document.getElementById('cc-map');
  const lines = document.getElementById('cc-lines') as SVGSVGElement | null;
  const wide = window.matchMedia('(min-width: 768px)');

  // ── 連線：把每張卡片連到人形上的號碼點（只在寬螢幕畫） ──
  function drawLines() {
    if (!map || !lines) return;
    lines.textContent = '';
    if (!wide.matches) return;
    const box = map.getBoundingClientRect();
    lines.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);

    for (const card of Array.from(map.querySelectorAll<HTMLElement>('.cc-card'))) {
      const id = card.dataset.region;
      const cb = card.getBoundingClientRect();
      const active = card.querySelector('input:checked') !== null;
      const ax = card.dataset.side === 'left' ? cb.right - box.left : cb.left - box.left;
      const ay = cb.top - box.top + 22;

      map.querySelectorAll<SVGGElement>(`.cc-marker[data-region="${id}"]`).forEach((m) => {
        const mb = m.getBoundingClientRect();
        const tx = mb.left + mb.width / 2 - box.left;
        const ty = mb.top + mb.height / 2 - box.top;
        const midx = card.dataset.side === 'left' ? ax + 14 : ax - 14;
        const d = `M${ax},${ay} L${midx},${ay} L${tx},${ty}`;
        for (const [stroke, width] of [
          ['var(--color-panel)', '5'],
          [active ? 'var(--color-accent)' : 'var(--color-muted)', active ? '2.5' : '1.5'],
        ] as const) {
          const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          p.setAttribute('d', d);
          p.setAttribute('fill', 'none');
          p.setAttribute('stroke', stroke);
          p.setAttribute('stroke-width', width);
          p.setAttribute('stroke-linejoin', 'round');
          p.setAttribute('stroke-linecap', 'round');
          lines.append(p);
        }
        const circle = m.querySelector('circle');
        if (circle) circle.style.fill = active ? 'var(--color-accent)' : 'var(--color-band)';
        const text = m.querySelector('text');
        if (text) text.style.fill = active ? 'var(--color-ctatext, #08243c)' : '#ffffff';
      });
    }
  }

  // 手機：點人形上的號碼，捲到對應的卡片
  map?.querySelectorAll<SVGGElement>('.cc-marker').forEach((m) => {
    m.style.cursor = 'pointer';
    m.addEventListener('click', () => {
      const card = map.querySelector<HTMLElement>(`.cc-card[data-region="${m.dataset.region}"]`);
      card?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card?.classList.add('ring-2', 'ring-accent');
      setTimeout(() => card?.classList.remove('ring-2', 'ring-accent'), 1600);
    });
  });

  let raf = 0;
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(drawLines);
  };
  window.addEventListener('resize', schedule);
  window.addEventListener('load', schedule);
  document.fonts?.ready.then(schedule);
  map?.addEventListener('change', schedule);
  schedule();

  if (form && result) {
    type Level = 'red' | 'other' | 'none';

    const RESULTS: Record<
      Level,
      { emoji: string; title: string; cls: string; lead: string; actions: string[] }
    > = {
      red: {
        emoji: '🔴',
        title: '立刻停止活動並就醫',
        cls: 'border-red-500 bg-red-500/15',
        lead: '你勾到的項目屬於必須立即處理的警訊。不要再上雪道、不要自己想辦法撐過去，現在就找人幫忙。',
        actions: [
          '立刻呼叫雪場巡邏隊，或撥打當地緊急電話（日本是 119）。',
          '懷疑頸部受傷時不要移動頭頸，也不要自行拆下安全帽。',
          '不要一個人待著，也不要自己開車或搭纜車下山。',
          '在醫師看過之前，不要喝酒、不要自行服用止痛藥 —— 會蓋住症狀變化。',
          '把症狀出現的時間、怎麼撞到的、有沒有失去意識記下來，看診時醫師會問。',
        ],
      },
      other: {
        emoji: '🟠',
        title: '今天不要再上雪道，並找人陪',
        cls: 'border-orange-400 bg-orange-500/15',
        lead: '你勾到的症狀雖然不是立即危險的警訊，但腦震盪的症狀常常是慢慢浮現的。今天到此為止，是最重要的一步。',
        actions: [
          '當天不要再滑，即使覺得「好像還可以」。',
          '接下來 24 小時盡量有人陪，請同行者留意你的意識、說話和行為有沒有變化。',
          '只要出現紅點裡的任何一項（劇烈頭痛、反覆嘔吐、意識變差、手腳無力…），立刻就醫。',
          '不要喝酒、不要自己開車，並且盡量讓大腦休息，減少長時間看螢幕。',
          '症狀在 48 小時內沒有改善或反而變重，請就醫。',
          '回到雪上之前要先讓醫師評估 —— 症狀還在的時候再撞一次，是最危險的情況。',
        ],
      },
      none: {
        emoji: '🟡',
        title: '目前沒有勾到症狀，但仍要觀察',
        cls: 'border-amber-400 bg-amber-500/15',
        lead: '沒有勾到任何一項，不代表沒有腦震盪。症狀可能在數小時後、甚至隔天才出現。',
        actions: [
          '如果今天有撞到頭，建議當天就降低強度或直接收工。',
          '接下來 24 小時請同行者留意你的狀況，不要獨處。',
          '任何新出現的症狀 —— 頭痛變重、想吐、想睡、反應變慢 —— 都請回到這一頁重新勾選。',
          '安全帽有明顯撞擊痕跡或裂痕，請更換，它已經替你吸收過一次能量。',
        ],
      },
    };

    const box = document.getElementById('cc-box');
    const flagsWrap = document.getElementById('cc-flags-wrap');
    const othersWrap = document.getElementById('cc-others-wrap');

    const fill = (id: string, items: string[]) => {
      const ul = document.getElementById(id);
      if (!ul) return;
      ul.textContent = '';
      for (const t of items) {
        const li = document.createElement('li');
        li.textContent = '· ' + t;
        ul.append(li);
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const checked = Array.from(
        form.querySelectorAll<HTMLInputElement>('input[name="symptom"]:checked')
      );
      const reds = checked.filter((c) => c.dataset.level === 'red').map((c) => c.value);
      const others = checked.filter((c) => c.dataset.level !== 'red').map((c) => c.value);

      const level: Level = reds.length ? 'red' : others.length ? 'other' : 'none';
      const r = RESULTS[level];

      if (box) box.className = `rounded-2xl border-l-4 p-6 sm:p-8 ${r.cls}`;
      const set = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      set('cc-emoji', r.emoji);
      set('cc-title', r.title);
      set('cc-lead', r.lead);

      const actions = document.getElementById('cc-actions');
      if (actions) {
        actions.textContent = '';
        for (const a of r.actions) {
          const li = document.createElement('li');
          li.className = 'flex gap-2.5';
          const dot = document.createElement('span');
          dot.textContent = '·';
          dot.className = 'shrink-0 font-bold';
          const span = document.createElement('span');
          span.textContent = a;
          li.append(dot, span);
          actions.append(li);
        }
      }

      if (flagsWrap) {
        fill('cc-flags', reds);
        flagsWrap.hidden = reds.length === 0;
      }
      if (othersWrap) {
        fill('cc-others', others);
        othersWrap.hidden = others.length === 0 || level !== 'red';
      }

      (window as any).snowmedTrack?.('done', 'concussion');
      (window as any).snowmedTrack?.('result', 'concussion/' + level);

      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    document.getElementById('cc-reset')?.addEventListener('click', () => {
      result.hidden = true;
      setTimeout(schedule, 0);
    });
  }
</script>
